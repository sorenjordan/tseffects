  	# Function output#
    # Increment s.test because counter starts at s = 0#
	gecm.to.adl(x.vrbl = x.vrbl, y.vrbl = y.vrbl, x.d.vrbl = x.d.vrbl, y.d.vrbl = y.d.vrbl)$y.vrbl.adl, # to get mpoly obj as character, you need to print#
#
    # Expected output#
    c("l_1_y+1" = 1)#
  )
