#
#########################################################################
## plm#
#########################################################################
library(plm)#
library(sampleSelection) # for some data#
#
data(nlswork)#
data.full <- nlswork#
#
model.re.plm <- plm(ln_wage ~ wks_work + union, index = c("idcode", "year"), #
    data = data.full,#
    model = "random", #
    random.method = "swar", #
    effect = "individual") #
#
summary(model.re.plm)#
#
check.model.class(model.re.plm)#
#
# output of insight#
insight::get_varcov(model.re.plm) # named symmetric#
insight::get_parameters(model.re.plm) # data.frame, Parameter[,1] / Estimate [,2] of fixed components#
insight::get_modelmatrix(model.re.plm) # data.frame#
#
# do new methods work?#
get.model.vcov(model.re.plm) # named symmetric#
get.model.coef(model.re.plm) # named vector#
get.model.data(model.re.plm) # data.frame#
#
adl.plot(model = model.re.plm, x.vrbl = c("wks_work" = 0), shock.history = "step")
library(fixest)#
#
model.fixest <- feols(ln_wage ~ wks_work + union | idcode + year, data = data.full)#
summary(model.fixest)#
#
check.model.class(model.fixest)#
#
# output of insight#
insight::get_varcov(model.fixest) # named symmetric#
insight::get_parameters(model.fixest) # data.frame, Parameter[,1] / Estimate [,2] of fixed components#
insight::get_modelmatrix(model.fixest) # data.frame#
#
# do new methods work?#
get.model.vcov(model.fixest) # named symmetric#
get.model.coef(model.fixest) # named vector#
get.model.data(model.fixest) # data.frame#
#
adl.plot(model = model.fixest, x.vrbl = c("wks_work" = 0), shock.history = "step")
