test_that("GDRF.dummy.checks produces the correct warnings and errors", {#
#
  # effect.type invalid#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "cough", prediction.values = NULL, baseline.y = NULL,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "Invalid effect.type. effect.type must be one of 'discrete' or 'fitted'"#
  )#
#
  # shock.size not numeric#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "discrete", prediction.values = NULL, baseline.y = NULL,#
      baseline.y.se = 0, shock.size = "cough", d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "shock.size must be numeric"#
  )#
#
  # shock.size length > 1#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "discrete", prediction.values = NULL, baseline.y = NULL,#
      baseline.y.se = 0, shock.size = c(1, 2), d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "shock.size should be a single value"#
  )#
#
  # effect.type = "discrete" with prediction.values supplied#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "discrete", prediction.values = list(x = 1), baseline.y = NULL,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "Do not supply prediction.values when effect.type = 'discrete'"#
  )#
#
  # effect.type = "discrete" with baseline.y supplied and non-zero#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "discrete", prediction.values = NULL, baseline.y = 5,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "Do not supply baseline.y when effect.type = 'discrete'"#
  )#
#
  # effect.type = "discrete" with baseline.y.se supplied and non-zero#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "discrete", prediction.values = NULL, baseline.y = NULL,#
      baseline.y.se = 1, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "Do not supply baseline.y.se when effect.type = 'discrete'"#
  )#
#
  # effect.type = "fitted", both prediction.values and baseline.y are NULL#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = NULL, baseline.y = NULL,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "You must provide either a baseline.y value or prediction.values"#
  )#
#
  # effect.type = "fitted", prediction.values not a list#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = c(x = 1), baseline.y = NULL,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "If using prediction.values, it must be a list"#
  )#
#
  # effect.type = "fitted", prediction.values supplied with non-zero baseline.y.se#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = list(x = 1), baseline.y = NULL,#
      baseline.y.se = 1, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "If using prediction.values, do not change baseline.y.se from 0"#
  )#
#
  # effect.type = "fitted", baseline.y not numeric#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = NULL, baseline.y = "cough",#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "If providing a baseline.y, it must be numeric"#
  )#
#
  # effect.type = "fitted", baseline.y length > 1#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = NULL, baseline.y = c(1, 2),#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "Only provide a single baseline.y value"#
  )#
#
  # effect.type = "fitted", baseline.y.se not numeric#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = NULL, baseline.y = 2,#
      baseline.y.se = "cough", shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "If providing a baseline.y.se, it must be numeric"#
  )#
#
  # effect.type = "fitted", baseline.y.se length > 1 (requires prediction.values = NULL per code check)#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = NULL, baseline.y = 2,#
      baseline.y.se = c(1, 2), shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "Only provide a single baseline.y.se value"#
  )#
#
  # effect.type = "fitted", d.y = 1, inferences.y = "levels", no baseline.y#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = NULL, baseline.y = NULL,#
      baseline.y.se = 0, shock.size = 1, d.y = 1, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "There is no baseline for y if effect.type = 'fitted' if d.y > 0"#
  )#
#
  # effect.type = "fitted", d.y = 0, both baseline.y and prediction.values supplied#
  expect_warning(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = list(x = 1), baseline.y = 5,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "Both baseline.y and prediction.values supplied; baseline.y takes precedence and prediction.values will be ignored"#
  )#
#
  # effect.type = "fitted", d.y = 0, prediction.values only (warns about differenced variables)#
  expect_warning(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = list(x = 1), baseline.y = NULL,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "If any differenced variables are included in the model, ensure they are set to 0 in prediction.values"#
  )#
#
  # effect.type = "fitted", d.y = 1, prediction.values supplied (warns, not errors)#
  expect_warning(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = list(x = 1), baseline.y = 0,#
      baseline.y.se = 0, shock.size = 1, d.y = 1, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "prediction.values is ignored when d.y > 0"#
  )#
#
  # effect.type = "fitted", d.y = 1, inferences.y = "differences", non-zero baseline.y#
  expect_warning(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = NULL, baseline.y = 5,#
      baseline.y.se = 0, shock.size = 1, d.y = 1, inferences.y = "differences", type = "GDRF"),#
#
    # Expected output#
    "Assuming anything other than baseline.y = 0 when inferences.y = 'differences' suggests the model is unstable"#
  )#
#
  # effect.type = "fitted", d.y = 1, inferences.y = "differences", shock.size = 1 (identical to discrete)#
  expect_warning(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = NULL, baseline.y = 0,#
      baseline.y.se = 0, shock.size = 1, d.y = 1, inferences.y = "differences", type = "GDRF"),#
#
    # Expected output#
    "effect.type = 'fitted' with inferences.y = 'differences' and shock.size = 1 is identical to effect.type = 'discrete'"#
  )#
#
  # type = "interact" produces "dynamic conditional effect" in error message, not "GDRF"#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "discrete", prediction.values = list(x = 1), baseline.y = NULL,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "interact"),#
#
    # Expected output#
    "dynamic conditional effect"#
  )#
#
  # effect.type = "discrete", baseline.y = 0 does not error (0 is the expected no-op value)#
  expect_no_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "discrete", prediction.values = NULL, baseline.y = 0,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF")#
  )#
#
  # effect.type = "discrete", baseline.y.se = 0 does not error (0 is the expected no-op value)#
  expect_no_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "discrete", prediction.values = NULL, baseline.y = NULL,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF")#
  )#
#
  # valid fitted call with baseline.y and d.y = 0 does not error or warn#
  expect_no_warning(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = NULL, baseline.y = 5,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF")#
  )#
#
  # valid fitted call with baseline.y and d.y = 1, inferences.y = "levels" does not error or warn#
  expect_no_warning(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = NULL, baseline.y = 5,#
      baseline.y.se = 0, shock.size = 1, d.y = 1, inferences.y = "levels", type = "GDRF")#
  )#
#
})
test_that("GDRF.dummy.checks produces the correct warnings and errors", {#
#
  # effect.type invalid#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "cough", prediction.values = NULL, baseline.y = NULL,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "Invalid effect.type. effect.type must be one of 'discrete' or 'fitted'"#
  )#
#
  # shock.size not numeric#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "discrete", prediction.values = NULL, baseline.y = NULL,#
      baseline.y.se = 0, shock.size = "cough", d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "shock.size must be numeric"#
  )#
#
  # shock.size length > 1#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "discrete", prediction.values = NULL, baseline.y = NULL,#
      baseline.y.se = 0, shock.size = c(1, 2), d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "shock.size should be a single value"#
  )#
#
  # effect.type = "discrete" with prediction.values supplied#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "discrete", prediction.values = list(x = 1), baseline.y = NULL,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "Do not supply prediction.values when effect.type = 'discrete'"#
  )#
#
  # effect.type = "discrete" with baseline.y supplied and non-zero#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "discrete", prediction.values = NULL, baseline.y = 5,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "Do not supply baseline.y when effect.type = 'discrete'"#
  )#
#
  # effect.type = "discrete" with baseline.y.se supplied and non-zero#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "discrete", prediction.values = NULL, baseline.y = NULL,#
      baseline.y.se = 1, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "Do not supply baseline.y.se when effect.type = 'discrete'"#
  )#
#
  # effect.type = "fitted", both prediction.values and baseline.y are NULL#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = NULL, baseline.y = NULL,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "You must provide either a baseline.y value or prediction.values"#
  )#
#
  # effect.type = "fitted", prediction.values not a list#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = c(x = 1), baseline.y = NULL,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "If using prediction.values, it must be a list"#
  )#
#
  # effect.type = "fitted", prediction.values supplied with non-zero baseline.y.se#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = list(x = 1), baseline.y = NULL,#
      baseline.y.se = 1, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "If using prediction.values, do not change baseline.y.se from 0"#
  )#
#
  # effect.type = "fitted", baseline.y not numeric#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = NULL, baseline.y = "cough",#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "If providing a baseline.y, it must be numeric"#
  )#
#
  # effect.type = "fitted", baseline.y length > 1#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = NULL, baseline.y = c(1, 2),#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "Only provide a single baseline.y value"#
  )#
#
  # effect.type = "fitted", baseline.y.se not numeric#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = NULL, baseline.y = 2,#
      baseline.y.se = "cough", shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "If providing a baseline.y.se, it must be numeric"#
  )#
#
  # effect.type = "fitted", baseline.y.se length > 1 (requires prediction.values = NULL per code check)#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = NULL, baseline.y = 2,#
      baseline.y.se = c(1, 2), shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "Only provide a single baseline.y.se value"#
  )#
#
  # effect.type = "fitted", d.y = 1, inferences.y = "levels", no baseline.y#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = list(x = 1), baseline.y = NULL,#
      baseline.y.se = 0, shock.size = 1, d.y = 1, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "There is no baseline for y if effect.type = 'fitted' if d.y > 0"#
  )#
#
  # effect.type = "fitted", d.y = 0, both baseline.y and prediction.values supplied#
  expect_warning(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = list(x = 1), baseline.y = 5,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "Both baseline.y and prediction.values supplied; baseline.y takes precedence and prediction.values will be ignored"#
  )#
#
  # effect.type = "fitted", d.y = 0, prediction.values only (warns about differenced variables)#
  expect_warning(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = list(x = 1), baseline.y = NULL,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "If any differenced variables are included in the model, ensure they are set to 0 in prediction.values"#
  )#
#
  # effect.type = "fitted", d.y = 1, prediction.values supplied (warns, not errors)#
  expect_warning(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = list(x = 1), baseline.y = 0,#
      baseline.y.se = 0, shock.size = 1, d.y = 1, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "prediction.values is ignored when d.y > 0"#
  )#
#
  # effect.type = "fitted", d.y = 1, inferences.y = "differences", non-zero baseline.y#
  expect_warning(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = NULL, baseline.y = 5,#
      baseline.y.se = 0, shock.size = 1, d.y = 1, inferences.y = "differences", type = "GDRF"),#
#
    # Expected output#
    "Assuming anything other than baseline.y = 0 when inferences.y = 'differences' suggests the model is unstable"#
  )#
#
  # effect.type = "fitted", d.y = 1, inferences.y = "differences", shock.size = 1 (identical to discrete)#
  expect_warning(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = NULL, baseline.y = 0,#
      baseline.y.se = 0, shock.size = 1, d.y = 1, inferences.y = "differences", type = "GDRF"),#
#
    # Expected output#
    "effect.type = 'fitted' with inferences.y = 'differences' and shock.size = 1 is identical to effect.type = 'discrete'"#
  )#
#
  # type = "interact" produces "dynamic conditional effect" in error message, not "GDRF"#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "discrete", prediction.values = list(x = 1), baseline.y = NULL,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "interact"),#
#
    # Expected output#
    "dynamic conditional effect"#
  )#
#
  # effect.type = "discrete", baseline.y = 0 does not error (0 is the expected no-op value)#
  expect_no_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "discrete", prediction.values = NULL, baseline.y = 0,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF")#
  )#
#
  # effect.type = "discrete", baseline.y.se = 0 does not error (0 is the expected no-op value)#
  expect_no_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "discrete", prediction.values = NULL, baseline.y = NULL,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF")#
  )#
#
  # valid fitted call with baseline.y and d.y = 0 does not error or warn#
  expect_no_warning(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = NULL, baseline.y = 5,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF")#
  )#
#
  # valid fitted call with baseline.y and d.y = 1, inferences.y = "levels" does not error or warn#
  expect_no_warning(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = NULL, baseline.y = 5,#
      baseline.y.se = 0, shock.size = 1, d.y = 1, inferences.y = "levels", type = "GDRF")#
  )#
#
})
test_that("adl.dummy.checks produces the correct errors and warnings (GDRF type)", {#
#
  # run a model to use for tests#
  model <- lm(y ~ l_1_y + l_1_x, data = toy.ts.interaction.data)#
#
  # is.null(x.vrbl)#
  expect_error(#
    # Function output#
    adl.dummy.checks(x.vrbl = NULL, y.vrbl = c("l_1_y" = 1), z.vrbl = NULL, x.z.vrbl = NULL,#
      d.x = 0, d.y = 0, inferences.x = "levels", inferences.y = "levels",#
      the.coef = coef(model), se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "Variables in GDRF terms \\(x and possibly y\\) must be"#
  )#
#
  # is.null(y.vrbl) warns#
  expect_warning(#
    # Function output#
    adl.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = NULL, z.vrbl = NULL, x.z.vrbl = NULL,#
      d.x = 0, d.y = 0, inferences.x = "levels", inferences.y = "levels",#
      the.coef = coef(model), se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "No y.vrbl in GDRF terms implies"#
  )#
#
  # x.vrbl not numeric (unnamed character vector)#
  expect_error(#
    # Function output#
    adl.dummy.checks(x.vrbl = c("l_1_x"), y.vrbl = c("l_1_y" = 1), z.vrbl = NULL, x.z.vrbl = NULL,#
      d.x = 0, d.y = 0, inferences.x = "levels", inferences.y = "levels",#
      the.coef = coef(model), se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "x.vrbl should be a named vector"#
  )#
#
  # x.vrbl not named (unnamed numeric vector)#
  expect_error(#
    # Function output#
    adl.dummy.checks(x.vrbl = c(1), y.vrbl = c("l_1_y" = 1), z.vrbl = NULL, x.z.vrbl = NULL,#
      d.x = 0, d.y = 0, inferences.x = "levels", inferences.y = "levels",#
      the.coef = coef(model), se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "x.vrbl should be a named vector"#
  )#
#
  # y.vrbl not numeric (unnamed character vector)#
  expect_error(#
    # Function output#
    adl.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y"), z.vrbl = NULL, x.z.vrbl = NULL,#
      d.x = 0, d.y = 0, inferences.x = "levels", inferences.y = "levels",#
      the.coef = coef(model), se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "y.vrbl should be a named vector"#
  )#
#
  # y.vrbl not named (unnamed numeric vector)#
  expect_error(#
    # Function output#
    adl.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c(1), z.vrbl = NULL, x.z.vrbl = NULL,#
      d.x = 0, d.y = 0, inferences.x = "levels", inferences.y = "levels",#
      the.coef = coef(model), se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "y.vrbl should be a named vector"#
  )#
#
  # se.type not valid#
  expect_error(#
    # Function output#
    adl.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), z.vrbl = NULL, x.z.vrbl = NULL,#
      d.x = 0, d.y = 0, inferences.x = "levels", inferences.y = "levels",#
      the.coef = coef(model), se.type = "cough", type = "GDRF"),#
#
    # Expected output#
    "Invalid se.type"#
  )#
#
  # x.vrbl not in model#
  expect_error(#
    # Function output#
    adl.dummy.checks(x.vrbl = c("cough" = 1), y.vrbl = c("l_1_y" = 1), z.vrbl = NULL, x.z.vrbl = NULL,#
      d.x = 0, d.y = 0, inferences.x = "levels", inferences.y = "levels",#
      the.coef = coef(model), se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "x.vrbl not present"#
  )#
#
  # y.vrbl not in model#
  expect_error(#
    # Function output#
    adl.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("cough" = 1), z.vrbl = NULL, x.z.vrbl = NULL,#
      d.x = 0, d.y = 0, inferences.x = "levels", inferences.y = "levels",#
      the.coef = coef(model), se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "y.vrbl not present"#
  )#
#
  # d.x missing#
  expect_error(#
    # Function output#
    adl.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), z.vrbl = NULL, x.z.vrbl = NULL,#
      d.x = NULL, d.y = 0, inferences.x = "levels", inferences.y = "levels",#
      the.coef = coef(model), se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "Order of differencing of variables in GDRF terms must be specified through d.x and d.y"#
  )#
#
  # d.y missing with y.vrbl supplied#
  expect_error(#
    # Function output#
    adl.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), z.vrbl = NULL, x.z.vrbl = NULL,#
      d.x = 0, d.y = NULL, inferences.x = "levels", inferences.y = "levels",#
      the.coef = coef(model), se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "Order of differencing of variables in GDRF terms must be specified through d.x and d.y"#
  )#
#
  # d.y missing with no y.vrbl (suppressing the y.vrbl = NULL warning)#
  suppressWarnings(expect_error(#
    # Function output#
    adl.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = NULL, z.vrbl = NULL, x.z.vrbl = NULL,#
      d.x = 0, d.y = NULL, inferences.x = "levels", inferences.y = "levels",#
      the.coef = coef(model), se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "Even if there is no y.vrbl in GDRF"#
  ))#
#
  # d.x not integer#
  expect_error(#
    # Function output#
    adl.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), z.vrbl = NULL, x.z.vrbl = NULL,#
      d.x = 1.5, d.y = 0, inferences.x = "levels", inferences.y = "levels",#
      the.coef = coef(model), se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "Order of differencing of variables in GDRF terms \\(d.x and d.y\\) must be an integer"#
  )#
#
  # d.y not integer#
  expect_error(#
    # Function output#
    adl.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), z.vrbl = NULL, x.z.vrbl = NULL,#
      d.x = 0, d.y = 1.5, inferences.x = "levels", inferences.y = "levels",#
      the.coef = coef(model), se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "Order of differencing of variables in GDRF terms \\(d.x and d.y\\) must be an integer"#
  )#
#
  # inferences.x not a valid string#
  expect_error(#
    # Function output#
    adl.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), z.vrbl = NULL, x.z.vrbl = NULL,#
      d.x = 0, d.y = 0, inferences.x = "cough", inferences.y = "levels",#
      the.coef = coef(model), se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "Invalid inferences.x. The shock history"#
  )#
#
  # inferences.y not a valid string#
  expect_error(#
    # Function output#
    adl.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), z.vrbl = NULL, x.z.vrbl = NULL,#
      d.x = 0, d.y = 0, inferences.x = "levels", inferences.y = "cough",#
      the.coef = coef(model), se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "Invalid inferences.y. The response function"#
  )#
#
  # inferences.x = "differences" nonsensical when d.x = 0#
  expect_error(#
    # Function output#
    adl.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), z.vrbl = NULL, x.z.vrbl = NULL,#
      d.x = 0, d.y = 0, inferences.x = "differences", inferences.y = "levels",#
      the.coef = coef(model), se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "Invalid inferences.x. The shock history for x cannot be in a higher order"#
  )#
#
  # inferences.y = "differences" nonsensical when d.y = 0#
  expect_error(#
    # Function output#
    adl.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), z.vrbl = NULL, x.z.vrbl = NULL,#
      d.x = 0, d.y = 0, inferences.x = "levels", inferences.y = "differences",#
      the.coef = coef(model), se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "Invalid inferences.y. The response function for y cannot be in a higher order"#
  )#
#
  # valid inputs with d.x = 0 produce no error#
  expect_no_error(#
    # Function output#
    adl.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), z.vrbl = NULL, x.z.vrbl = NULL,#
      d.x = 0, d.y = 0, inferences.x = "levels", inferences.y = "levels",#
      the.coef = coef(model), se.type = "const", type = "GDRF")#
  )#
#
  # inferences.x = "differences" is valid when d.x = 1#
  expect_no_error(#
    # Function output#
    adl.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), z.vrbl = NULL, x.z.vrbl = NULL,#
      d.x = 1, d.y = 0, inferences.x = "differences", inferences.y = "levels",#
      the.coef = coef(model), se.type = "const", type = "GDRF")#
  )#
#
})#
