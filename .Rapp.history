#########################################################################
## dynlm#
#########################################################################
library(dynlm)#
#
toy.ts.interaction.data.ts <- ts(toy.ts.interaction.data, start = 1, end = 50, frequency = 1)#
#
model.dynlm <- dynlm(y ~ L(y, 1) + x + L(x, 1) + L(x, 2) + z + L(z, 1) + L(z, 2), data = toy.ts.interaction.data.ts)#
summary(model.dynlm)#
#
check.model.class(model.dynlm)#
#
# output of insight#
insight::get_varcov(model.dynlm) # named symmetric#
insight::get_parameters(model.dynlm) # data.frame, Parameter[,1] / Estimate [,2]#
insight::get_modelmatrix(model.dynlm) # data.frame#
#
# do new methods work?#
get.model.vcov(model.dynlm) # named symmetric#
get.model.coef(model.dynlm) # named vector#
get.model.data(model.dynlm) # data.frame#
#
adl.plot(model = model.dynlm, y.vrbl = c("L(y, 1)" = 1), x.vrbl = c("x" = 0, "L(x, 1)" = 1, "L(x, 2)" = 2), shock.history = "step")
