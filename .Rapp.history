test_that("Correct Plot: GDRF.gecm.plot", {#
  local_edition(3)#
  model <- lm(d_y ~ l_1_x + l_1_y + d_x + l_1_d_x + l_1_d_y, data = toy.ts.interaction.data)#
  one <- GDRF.gecm.plot(model = model, #
                       x.vrbl = c("l_1_x" = 1), #
                       y.vrbl = c("l_1_y" = 1),#
                       x.vrbl.d.x = 0, #
                       y.vrbl.d.y = 0,#
                       x.d.vrbl = c("d_x" = 0, "l_1_d_x" = 1), #
                       y.d.vrbl = c("l_1_d_y" = 1),#
                       x.d.vrbl.d.x = 1, #
                       y.d.vrbl.d.y = 1,#
                       shock.history = "pte", #
                       inferences.y = "levels", #
                       inferences.x = "levels",#
                       s.limit = 2,  #
                       return.formulae = FALSE, #
                       return.plot =  TRUE,#
                       return.data = FALSE)#
  expect_no_error(one) #
  expect_doppelganger("one", one)#
  expect_snapshot("one")#
  two <- GDRF.gecm.plot(model = model, #
                       x.vrbl = c("l_1_x" = 1), #
                       y.vrbl = c("l_1_y" = 1),#
                       x.vrbl.d.x = 0, #
                       y.vrbl.d.y = 0,#
                       x.d.vrbl = c("d_x" = 0, "l_1_d_x" = 1), #
                       y.d.vrbl = c("l_1_d_y" = 1),#
                       x.d.vrbl.d.x = 1, #
                       y.d.vrbl.d.y = 1,#
                       shock.history = "ste", #
                       inferences.y = "levels", #
                       inferences.x = "levels",#
                       s.limit = 2,  #
                       return.formulae = FALSE, #
                       return.plot =  TRUE,#
                       return.data = FALSE)#
  expect_no_error(two) #
  expect_doppelganger("two", two)#
  expect_snapshot("two")#
})
