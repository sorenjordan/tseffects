	gecm.to.adl(x.vrbl = x.vrbl, y.vrbl = y.vrbl, x.d.vrbl = x.d.vrbl, y.d.vrbl = y.d.vrbl)$x.vrbl.adl, # to get mpoly obj as character, you need to print#
