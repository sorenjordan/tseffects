			if(is.null(baseline.y)) {#
				stop("There is no natural baseline for y if effect.type = 'fitted' if d.y > 0. You must specify a baseline value through baseline.y (with optional uncertainty through baseline.y.se)")#
			} else {#
				baseline <- baseline.y#
			}#
		}#
	}#
    # modify formulae: prepend baseline to each formula string#
	modified.formulae <- lapply(formulae, function(f) {#
		paste0(baseline, " + ", shock.size, " * (", f, ")")#
	})#
	modified.formulae#
}
