    adl.dummy.checks(x.vrbl = c("x" = 0, "l_1_x" = 1), y.vrbl = c("l_1_y" = 1),#
      z.vrbl = c(0), x.z.vrbl = c("x_z" = 0),#
      d.x = NULL, d.y = NULL, inferences.x = NULL, inferences.y = NULL,#
      the.coef = coef(model), se.type = "const", type = "interact"),#
#
    # Expected output#
    "z.vrbl should be a named vector"#
  )#
#
  # x.z.vrbl not numeric (unnamed character vector)#
  expect_error(#
    # Function output#
    adl.dummy.checks(x.vrbl = c("x" = 0, "l_1_x" = 1), y.vrbl = c("l_1_y" = 1),#
      z.vrbl = c("z" = 0), x.z.vrbl = c("x_z"),#
      d.x = NULL, d.y = NULL, inferences.x = NULL, inferences.y = NULL,#
      the.coef = coef(model), se.type = "const", type = "interact"),#
#
    # Expected output#
    "x.z.vrbl should be a named vector"#
  )#
#
  # x.z.vrbl not named (unnamed numeric vector)#
  expect_error(#
    # Function output#
    adl.dummy.checks(x.vrbl = c("x" = 0, "l_1_x" = 1), y.vrbl = c("l_1_y" = 1),#
      z.vrbl = c("z" = 0), x.z.vrbl = c(0),#
      d.x = NULL, d.y = NULL, inferences.x = NULL, inferences.y = NULL,#
      the.coef = coef(model), se.type = "const", type = "interact"),#
#
    # Expected output#
    "x.z.vrbl should be a named vector"#
  )#
#
  # z.vrbl not in model#
  expect_error(#
    # Function output#
    adl.dummy.checks(x.vrbl = c("x" = 0, "l_1_x" = 1), y.vrbl = c("l_1_y" = 1),#
      z.vrbl = c("cough" = 0), x.z.vrbl = c("x_z" = 0),#
      d.x = NULL, d.y = NULL, inferences.x = NULL, inferences.y = NULL,#
      the.coef = coef(model), se.type = "const", type = "interact"),#
#
    # Expected output#
    "z.vrbl not present"#
  )#
#
  # x.z.vrbl not in model#
  expect_error(#
    # Function output#
    adl.dummy.checks(x.vrbl = c("x" = 0, "l_1_x" = 1), y.vrbl = c("l_1_y" = 1),#
      z.vrbl = c("z" = 0), x.z.vrbl = c("cough" = 0),#
      d.x = NULL, d.y = NULL, inferences.x = NULL, inferences.y = NULL,#
      the.coef = coef(model), se.type = "const", type = "interact"),#
#
    # Expected output#
    "x.z.vrbl not present"#
  )#
#
  # valid inputs produce no error#
  expect_no_error(#
    # Function output#
    adl.dummy.checks(x.vrbl = c("x" = 0, "l_1_x" = 1), y.vrbl = c("l_1_y" = 1),#
      z.vrbl = c("z" = 0), x.z.vrbl = c("x_z" = 0),#
      d.x = NULL, d.y = NULL, inferences.x = NULL, inferences.y = NULL,#
      the.coef = coef(model), se.type = "const", type = "interact")#
  )#
#
})
# inferences.y = "differences" is valid when d.y = 1#
  expect_no_error(#
    # Function output#
    adl.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), z.vrbl = NULL, x.z.vrbl = NULL,#
      d.x = 0, d.y = 1, inferences.x = "levels", inferences.y = "differences",#
      the.coef = coef(model), se.type = "const", type = "GDRF")#
  )
# inferences.y = "differences" is valid when d.y = 1#
  expect_no_error(#
    # Function output#
    adl.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_d_y" = 1), z.vrbl = NULL, x.z.vrbl = NULL,#
      d.x = 0, d.y = 1, inferences.x = "levels", inferences.y = "differences",#
      the.coef = coef(lm(d_y ~ l_1_d_y + l_1_x, data = toy.ts.interaction.data)),#
      se.type = "const", type = "GDRF")#
  )
test_that("gecm.dummy.checks produces the correct errors (GDRF type)", {#
#
  # run a model to use for tests#
  model <- lm(y ~ l_1_y + l_1_x + d_x + l_1_d_y, data = toy.ts.interaction.data)#
#
  # x.vrbl NULL#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = NULL, y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "Variables in GDRF terms \\(x and y\\)"#
  )#
#
  # y.vrbl NULL#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = NULL, x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "Variables in GDRF terms \\(x and y\\)"#
  )#
#
  # x.d.vrbl NULL#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = NULL, y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "Variables in GDRF terms \\(x and y\\)"#
  )#
#
  # x.vrbl.d.x missing#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = NULL, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "Order of differencing of variables in GDRF terms"#
  )#
#
  # y.vrbl.d.y missing#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = NULL, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "Order of differencing of variables in GDRF terms"#
  )#
#
  # x.d.vrbl.d.x missing#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = NULL, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "Order of differencing of variables in lagged differences in GDRF must"#
  )#
#
  # y.d.vrbl.d.y missing with y.d.vrbl defined#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = NULL,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "Order of differencing of variables in lagged differences in GDRF must"#
  )#
#
  # y.d.vrbl.d.y missing with y.d.vrbl not defined#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = NULL,#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = NULL,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "Even if variables in lagged differences in"#
  )#
#
  # x.vrbl.d.x not integer#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 1.5, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "Order of differencing of variables in GDRF term \\(x.vrbl.d.x and y.vrbl.d.y\\) must be an integer"#
  )#
#
  # y.vrbl.d.y not integer#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 1.5, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "Order of differencing of variables in GDRF term \\(x.vrbl.d.x and y.vrbl.d.y\\) must be an integer"#
  )#
#
  # x.d.vrbl.d.x not integer#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1.5, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "Order of differencing of variables in lagged differences in GDRF term \\(x.d.vrbl.d.x"#
  )#
#
  # y.d.vrbl.d.y not integer#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1.5,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "Order of differencing of variables in lagged differences in GDRF term \\(y.d.vrbl.d.y"#
  )#
#
  # x.vrbl unnamed#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c(1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "x.vrbl should be a named vector"#
  )#
#
  # x.vrbl not numeric#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x"), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "x.vrbl should be a named vector"#
  )#
#
  # y.vrbl unnamed#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c(1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "y.vrbl should be a named vector"#
  )#
#
  # y.vrbl not numeric#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y"), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "y.vrbl should be a named vector"#
  )#
#
  # x.d.vrbl unnamed#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c(0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "x.d.vrbl should be a named vector"#
  )#
#
  # x.d.vrbl not numeric#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x"), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "x.d.vrbl should be a named vector"#
  )#
#
  # y.d.vrbl unnamed#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c(1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "y.d.vrbl should be a named vector"#
  )#
#
  # y.d.vrbl not numeric#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y"),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "y.d.vrbl should be a named vector"#
  )#
#
  # x differencing ordering off (distance > 1)#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 2, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "In a GECM, the variable in differences should be one order of differencing"#
  )#
#
  # y differencing ordering off (distance > 1)#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 2,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "In a GECM, the variable in differences should be one order of differencing"#
  )#
#
  # multiple lags in x.vrbl#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1, "l_2_x" = 2), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "In a GECM, include only the first lag of the variable"#
  )#
#
  # multiple lags in y.vrbl#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1, "l_2_y" = 2), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "In a GECM, include only the first lag of the variable"#
  )#
#
  # x.vrbl not at lag 1#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 2), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "In a GECM, include only the first lag of the variable"#
  )#
#
  # y.vrbl not at lag 1#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 2), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "In a GECM, include only the first lag of the variable"#
  )#
#
  # inferences.x not levels#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "differences", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "In a GECM, inferences regarding the GDRF of x"#
  )#
#
  # inferences.y not levels#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "differences", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "In a GECM, inferences regarding the GDRF of x"#
  )#
#
  # se.type not valid#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "cough", type = "GDRF"),#
#
    # Expected output#
    "Invalid se.type"#
  )#
#
  # x.vrbl not in model#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("cough" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "x.vrbl not present in estimated model"#
  )#
#
  # y.vrbl not in model#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("cough" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "y.vrbl not present in estimated model"#
  )#
#
  # x.d.vrbl not in model#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("cough" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "x.d.vrbl not present in estimated model"#
  )#
#
  # y.d.vrbl not in model#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("cough" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "y.d.vrbl not present in estimated model"#
  )#
#
  # valid inputs produce no error#
  expect_no_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF")#
  )#
#
  # valid inputs with no y.d.vrbl produce no error#
  expect_no_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = NULL,#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF")#
  )#
#
})
# required for package#
library(mpoly)#
library(car)#
library(ggplot2)#
library(see)#
library(colorspace)#
library(stats)#
library(sandwich)#
library(utils)#
#
# required for tester#
library(testthat)#
library(vdiffr)#
#
# For Soren#
source("/Users/sorenjordan/Dropbox/Myfiles/Research/Garrett-Soren (archive)/tseffects/tseffects/tseffects-nextversion-beta.R")#
load("/Users/sorenjordan/Dropbox/Myfiles/Research/Garrett-Soren (archive)/tseffects/tseffects/data/approval.rda")#
load("/Users/sorenjordan/Dropbox/Myfiles/Research/Garrett-Soren (archive)/tseffects/tseffects/data/toy.ts.interaction.data.rda")
test_that("gecm.dummy.checks produces the correct errors (GDRF type)", {#
#
  # run a model to use for tests#
  model <- lm(y ~ l_1_y + l_1_x + d_x + l_1_d_y, data = toy.ts.interaction.data)#
#
  # x.vrbl NULL#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = NULL, y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "Variables in GDRF terms \\(x and y\\)"#
  )#
#
  # y.vrbl NULL#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = NULL, x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "Variables in GDRF terms \\(x and y\\)"#
  )#
#
  # x.d.vrbl NULL#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = NULL, y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "Variables in GDRF terms \\(x and y\\)"#
  )#
#
  # x.vrbl.d.x missing#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = NULL, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "Order of differencing of variables in GDRF terms"#
  )#
#
  # y.vrbl.d.y missing#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = NULL, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "Order of differencing of variables in GDRF terms"#
  )#
#
  # x.d.vrbl.d.x missing#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = NULL, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "Order of differencing of variables in lagged differences in GDRF must"#
  )#
#
  # y.d.vrbl.d.y missing with y.d.vrbl defined#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = NULL,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "Order of differencing of variables in lagged differences in GDRF must"#
  )#
#
  # y.d.vrbl.d.y missing with y.d.vrbl not defined#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = NULL,#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = NULL,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "Even if variables in lagged differences in"#
  )#
#
  # x.vrbl.d.x not integer#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 1.5, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "Order of differencing of variables in GDRF term \\(x.vrbl.d.x and y.vrbl.d.y\\) must be an integer"#
  )#
#
  # y.vrbl.d.y not integer#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 1.5, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "Order of differencing of variables in GDRF term \\(x.vrbl.d.x and y.vrbl.d.y\\) must be an integer"#
  )#
#
  # x.d.vrbl.d.x not integer#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1.5, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "Order of differencing of variables in lagged differences in GDRF term \\(x.d.vrbl.d.x"#
  )#
#
  # y.d.vrbl.d.y not integer#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1.5,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "Order of differencing of variables in lagged differences in GDRF term \\(y.d.vrbl.d.y"#
  )#
#
  # x.vrbl unnamed#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c(1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "x.vrbl should be a named vector"#
  )#
#
  # x.vrbl not numeric#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x"), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "x.vrbl should be a named vector"#
  )#
#
  # y.vrbl unnamed#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c(1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "y.vrbl should be a named vector"#
  )#
#
  # y.vrbl not numeric#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y"), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "y.vrbl should be a named vector"#
  )#
#
  # x.d.vrbl unnamed#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c(0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "x.d.vrbl should be a named vector"#
  )#
#
  # x.d.vrbl not numeric#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x"), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "x.d.vrbl should be a named vector"#
  )#
#
  # y.d.vrbl unnamed#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c(1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "y.d.vrbl should be a named vector"#
  )#
#
  # y.d.vrbl not numeric#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y"),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "y.d.vrbl should be a named vector"#
  )#
#
  # x differencing ordering off (distance > 1)#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 2, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "In a GECM, the variable in differences should be one order of differencing"#
  )#
#
  # y differencing ordering off (distance > 1)#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 2,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "In a GECM, the variable in differences should be one order of differencing"#
  )#
#
  # multiple lags in x.vrbl#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1, "l_2_x" = 2), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "In a GECM, include only the first lag of the variable"#
  )#
#
  # multiple lags in y.vrbl#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1, "l_2_y" = 2), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "In a GECM, include only the first lag of the variable"#
  )#
#
  # x.vrbl not at lag 1#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 2), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "In a GECM, include only the first lag of the variable"#
  )#
#
  # y.vrbl not at lag 1#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 2), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "In a GECM, include only the first lag of the variable"#
  )#
#
  # inferences.x not levels#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "differences", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "In a GECM, inferences regarding the GDRF of x"#
  )#
#
  # inferences.y not levels#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "differences", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "In a GECM, inferences regarding the GDRF of x"#
  )#
#
  # se.type not valid#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "cough", type = "GDRF"),#
#
    # Expected output#
    "Invalid se.type"#
  )#
#
  # x.vrbl not in model#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("cough" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "x.vrbl not present in estimated model"#
  )#
#
  # y.vrbl not in model#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("cough" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "y.vrbl not present in estimated model"#
  )#
#
  # x.d.vrbl not in model#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("cough" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "x.d.vrbl not present in estimated model"#
  )#
#
  # y.d.vrbl not in model#
  expect_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("cough" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF"),#
#
    # Expected output#
    "y.d.vrbl not present in estimated model"#
  )#
#
  # valid inputs produce no error#
  expect_no_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = c("l_1_d_y" = 1),#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF")#
  )#
#
  # valid inputs with no y.d.vrbl produce no error#
  expect_no_error(#
    # Function output#
    gecm.dummy.checks(x.vrbl = c("l_1_x" = 1), y.vrbl = c("l_1_y" = 1), x.d.vrbl = c("d_x" = 0), y.d.vrbl = NULL,#
      x.vrbl.d.x = 0, y.vrbl.d.y = 0, x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
      inferences.x = "levels", inferences.y = "levels", the.coef = coef(model),#
      se.type = "const", type = "GDRF")#
  )#
#
})
test_that("what.to.return returns correct combinations of elements", {#
  # make some objects. the function doesn't check what the elements are, just their existence.#
  plot.out <- list("plot" = 1)#
  dat.out <- list("estimates" = 1)#
  the.final.formulae <- list("formulae" = 1, "shocks" = 2)#
#
  expect_equal( # return.plot TRUE | return.formulae TRUE | return.data TRUE#
    # Function output#
    what.to.return(return.plot = TRUE, return.formulae = TRUE, return.data = TRUE,#
      				plot.out = plot.out, dat.out = dat.out, the.final.formulae = the.final.formulae),#
#
    # Expected output#
    list("plot" = plot.out, "estimates" = dat.out, "formulae" = the.final.formulae$formulae, "shocks" = the.final.formulae$shocks)#
  )#
#
  expect_equal( # return.plot TRUE | return.formulae FALSE | return.data TRUE#
    # Function output#
    what.to.return(return.plot = TRUE, return.formulae = FALSE, return.data = TRUE,#
      				plot.out = plot.out, dat.out = dat.out, the.final.formulae = the.final.formulae),#
#
    # Expected output#
    list("plot" = plot.out, "estimates" = dat.out)#
  )#
#
  expect_equal( # return.plot TRUE | return.formulae TRUE | return.data FALSE#
    # Function output#
    what.to.return(return.plot = TRUE, return.formulae = TRUE, return.data = FALSE,#
      				plot.out = plot.out, dat.out = dat.out, the.final.formulae = the.final.formulae),#
#
    # Expected output#
    list("plot" = plot.out, "formulae" = the.final.formulae$formulae, "shocks" = the.final.formulae$shocks)#
  )#
#
  expect_equal( # return.plot TRUE | return.formulae FALSE | return.data FALSE#
    # Function output#
    what.to.return(return.plot = TRUE, return.formulae = FALSE, return.data = FALSE,#
      				plot.out = plot.out, dat.out = dat.out, the.final.formulae = the.final.formulae),#
#
    # Expected output#
    plot.out#
  )#
#
  expect_equal( # return.plot FALSE | return.formulae TRUE | return.data TRUE#
    # Function output#
    what.to.return(return.plot = FALSE, return.formulae = TRUE, return.data = TRUE,#
      				plot.out = plot.out, dat.out = dat.out, the.final.formulae = the.final.formulae),#
#
    # Expected output#
    list("estimates" = dat.out, "formulae" = the.final.formulae$formulae, "shocks" = the.final.formulae$shocks)#
  )#
#
  expect_equal( # return.plot FALSE | return.formulae FALSE | return.data TRUE#
    # Function output#
    what.to.return(return.plot = FALSE, return.formulae = FALSE, return.data = TRUE,#
      				plot.out = plot.out, dat.out = dat.out, the.final.formulae = the.final.formulae),#
#
    # Expected output#
    dat.out#
  )#
#
  expect_equal( # return.plot FALSE | return.formulae TRUE | return.data FALSE#
    # Function output#
    what.to.return(return.plot = FALSE, return.formulae = TRUE, return.data = FALSE,#
      				plot.out = plot.out, dat.out = dat.out, the.final.formulae = the.final.formulae),#
#
    # Expected output#
    list("formulae" = the.final.formulae$formulae, "shocks" = the.final.formulae$shocks)#
  )#
#
  expect_error( # return.plot FALSE | return.formulae FALSE | return.data FALSE#
    # Function output#
    what.to.return(return.plot = FALSE, return.formulae = FALSE, return.data = FALSE,#
      				plot.out = plot.out, dat.out = dat.out, the.final.formulae = the.final.formulae),#
#
    # Expected output#
    "Return at least one of the plot, the data, or the formulae"#
  )#
#
  expect_named( # return.plot TRUE | return.formulae TRUE | return.data TRUE: correct names#
    # Function output#
    what.to.return(return.plot = TRUE, return.formulae = TRUE, return.data = TRUE,#
      plot.out = plot.out, dat.out = dat.out, the.final.formulae = the.final.formulae),#
#
    # Expected output#
    c("plot", "estimates", "formulae", "shocks")#
  )#
})
test_that("mpoly.subber subs symbols correctly", {#
  dat <- data.frame(y = rnorm(25), #
  					x.1 = rnorm(25)#
  					)#
  dat$"d(x, 1)" <- rnorm(25)#
  model <- lm(y ~ x.1 + `d(x, 1)`, data = dat)#
#
  x.vrbl <- c("x.1" = 1, "`d(x, 1)`" = 2)#
  y.vrbl <- c("y" = 0)#
  x.d.vrbl <- c("x   1" = 1)#
  y.d.vrbl <- c("B()()B" = 1)#
  the.coef <- coef(model)#
  the.vcov <- vcov(model)#
  suppressWarnings(mpoly.subber(env = environment()))#
#
  suppressWarnings(expect_equal( # test x.vrbl#
 	  # Function output#
      names(x.vrbl), # to get mpoly obj as character, you need to print#
  	  # Expected output#
  	  c("x_1", "`d_x__1_`")#
   )#
  )   #
#
  suppressWarnings(expect_equal( # test y.vrbl#
 	  # Function output#
      names(y.vrbl), # to get mpoly obj as character, you need to print#
  	  # Expected output#
  	  c("y")#
   )#
  )   #
#
  suppressWarnings(expect_equal( # test x.d.vrbl#
 	  # Function output#
      names(x.d.vrbl), # to get mpoly obj as character, you need to print#
  	  # Expected output#
  	  'x___1'#
   )#
  )#
  suppressWarnings(expect_equal( # test y.d.vrbl#
 	  # Function output#
      names(y.d.vrbl), # to get mpoly obj as character, you need to print#
  	  # Expected output#
  	  'B____B'#
   )#
  )#
  suppressWarnings(expect_equal( # test the.coef#
 	  # Function output#
      names(the.coef), # to get mpoly obj as character, you need to print#
  	  # Expected output#
  	  c("(Intercept)", "x_1", "`d_x__1_`")#
   )#
  )  #
  suppressWarnings(expect_equal( # test the.vcov#
 	  # Function output#
      rownames(the.vcov), # to get mpoly obj as character, you need to print#
  	  # Expected output#
  	  c("(Intercept)", "x_1", "`d_x__1_`")#
   )#
  )    #
  suppressWarnings(expect_equal( # test the.vcov#
 	  # Function output#
      colnames(the.vcov), # to get mpoly obj as character, you need to print#
  	  # Expected output#
  	  c("(Intercept)", "x_1", "`d_x__1_`")#
   )#
  )#
  expect_warning(#
     # Function output#
     mpoly.subber(env = environment()),#
#
     # Expected output#
     "Variable names containing . replaced with _"#
  )  #
})
test_that("get.value returns correct values", {#
  model <- lm(y ~ l_1_y + x + l_1_x, data = toy.ts.interaction.data)#
#
  expect_equal( # user-supplied value is returned directly#
    # Function output#
    get.value(var = "x", prediction.values = list("x" = 5), model = model),#
#
    # Expected output#
    5#
  )#
#
  expect_equal( # user-supplied value of 0 is returned (not treated as missing)#
    # Function output#
    get.value(var = "x", prediction.values = list("x" = 0), model = model),#
#
    # Expected output#
    0#
  )#
#
  expect_warning( # variable not in prediction.values: mean used and warning issued#
    # Function output#
    get.value(var = "x", prediction.values = list(), model = model),#
#
    # Expected output#
    "x not in prediction.values; mean of series used"#
  )#
#
  expect_equal( # variable not in prediction.values: correct mean returned#
    # Function output#
    suppressWarnings(get.value(var = "x", prediction.values = list(), model = model)),#
#
    # Expected output#
    mean(model.frame(model)[["x"]], na.rm = TRUE)#
  )#
#
  expect_warning( # NA in prediction.values: mean used and warning issued#
    # Function output#
    get.value(var = "x", prediction.values = list("x" = NA), model = model),#
#
    # Expected output#
    "x not in prediction.values; mean of series used"#
  )#
#
  expect_equal( # NA in prediction.values: correct mean returned#
    # Function output#
    suppressWarnings(get.value(var = "x", prediction.values = list("x" = NA), model = model)),#
#
    # Expected output#
    mean(model.frame(model)[["x"]], na.rm = TRUE)#
  )#
#
  expect_equal( # correct mean returned for a different variable#
    # Function output#
    suppressWarnings(get.value(var = "l_1_x", prediction.values = list(), model = model)),#
#
    # Expected output#
    mean(model.frame(model)[["l_1_x"]], na.rm = TRUE)#
  )#
#
  expect_equal( # user-supplied value takes precedence over model mean#
    # Function output#
    get.value(var = "x", prediction.values = list("x" = 99), model = model),#
#
    # Expected output#
    99#
  )#
})
model <- lm(y ~ l_1_y + x + l_1_x, data = toy.ts.interaction.data)#
  model.diffs <- lm(d_y ~ l_1_d_y + x + l_1_x, data = toy.ts.interaction.data)#
#
  expect_warning( # fitted + d.y = 0 + both baseline.y and prediction.values#
    # Function output#
    GDRF.adl.plot(model = model.adl,#
                  x.vrbl = c("x" = 0, "l_1_x" = 1),#
                  y.vrbl = c("l_1_y" = 1),#
                  d.x = 0, d.y = 0,#
                  shock.history = "pulse",#
                  inferences.y = "levels", inferences.x = "levels",#
                  effect.type = "fitted",#
                  prediction.values = list("x" = 0, "l_1_x" = 0),#
                  baseline.y = 5,#
                  s.limit = 3, return.plot = FALSE, return.data = TRUE),#
#
    # Expected output#
    "Both baseline.y and prediction.values supplied; baseline.y takes precedence and prediction.values will be ignored"#
  )
