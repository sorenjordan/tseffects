#
yhat.calculator(	formulae = general$formulae, d.y = 0, model = model, the.coef = coef(model), #
					y.vrbl = c("l_1_y" = 1), inferences.y = "levels", prediction.values = NULL, baseline.y = NULL, shock.size = 1)
