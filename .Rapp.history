adl.plot(model = model.dynardl, y.vrbl = c("l.1.y" = 1), x.vrbl = c("x" = 0, "l.1.x" = 1, "l.2.x" = 2), shock.history = "step")#
# order of when to sub . for _ is off
adl.plot(model = model.dynardl, y.vrbl = c("l.1.y" = 1), x.vrbl = c("x" = 0, "l.1.x" = 1, "l.2.x" = 2), shock.history = "step")
