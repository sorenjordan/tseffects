				y.vrbl = c("l_1_y" = 1),#
				z.vrbl = c("z" = 0, "l_1_z" = 1), #
				x.z.vrbl = c("x_z" = 0, "z_l_1_x" = 1, "x_l_1_z" = 0, "l_1_x_l_1_z" = 1), #
				effect.type = "impulse", plot.type = "lines", line.options = "z.lines",#
				return.data = TRUE, return.formulae = TRUE, s.limit = 5)#
#
