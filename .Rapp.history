library(mpoly)#
library(car)#
library(ggplot2)#
library(see)#
library(colorspace)#
library(stats)#
library(sandwich)#
library(utils)#
# required for tester#
library(tidyverse)#
library(dynamac)#
library(lmtest)#
library(lattice)#
library(ggpubr)#
# Change these to DB path#
source("/Users/sorenjordan/Dropbox/Myfiles/Research/Garrett-Soren (archive)/tseffects/tseffects/tseffects-nextversion-beta.R")#
load("/Users/sorenjordan/Dropbox/Myfiles/Research/Garrett-Soren (archive)/tseffects/tseffects/data/approval.rda")#
load("/Users/sorenjordan/Dropbox/Myfiles/Research/Garrett-Soren (archive)/tseffects/tseffects/data/toy.ts.interaction.data.rda")
model.alllags <- lm(y ~ l_1_y +#
	x + l_1_x +#
	z + l_1_z  +#
	x_z + z_l_1_x + x_l_1_z +#
	l_1_x_l_1_z, data = toy.ts.interaction.data)#
#
summary(model.alllags)
test.interact.cumulative.lines.zlines <- interact.adl.plot(model = model.alllags, #
				x.vrbl = c("x" = 0, "l_1_x" = 1), #
				y.vrbl = c("l_1_y" = 1),#
				z.vrbl = c("z" = 0, "l_1_z" = 1), #
				x.z.vrbl = c("x_z" = 0, "z_l_1_x" = 1, "x_l_1_z" = 0, "l_1_x_l_1_z" = 1), #
				shock.history = "step", plot.type = "lines", line.options = "z.lines",#
				return.data = TRUE, return.formulae = TRUE, s.limit = 10)
test.interact.cumulative.lines.zlines$formulae
