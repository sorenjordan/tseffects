summary(model)#
#
test.gecm.levels.levels.pulse <- GDRF.gecm.plot(model = model, #
				x.vrbl = c("lx" = 1), y.vrbl = c("ly" = 1),#
				x.vrbl.d.x = 0, y.vrbl.d.y = 0,#
				x.d.vrbl = c("dx" = 0, "ldx" = 1), y.d.vrbl = c("ldy" = 1),#
				x.d.vrbl.d.x = 1,  y.d.vrbl.d.y = 1,#
				shock.history = "pulse", inferences.y = "levels", inferences.x = "levels",#
				s.limit = 2, return.plot = TRUE, return.formulae = TRUE)#
#
test.gecm.levels.levels.pulse$formulae#
test.gecm.levels.levels.pulse$plot#
#
test.gecm.levels.levels.ste <- GDRF.gecm.plot(model = model, #
				x.vrbl = c("lx" = 1), y.vrbl = c("ly" = 1),#
				x.vrbl.d.x = 0, y.vrbl.d.y = 0,#
				x.d.vrbl = c("dx" = 0, "ldx" = 1), y.d.vrbl = c("ldy" = 1),#
				x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
				shock.history = "step", inferences.y = "levels", inferences.x = "levels",#
				s.limit = 20, return.plot = TRUE, return.formulae = TRUE)#
#
test.gecm.levels.levels.ste$formulae#
test.gecm.levels.levels.ste$plot#
#
ggarrange(test.gecm.levels.levels.pulse$plot, test.gecm.levels.levels.ste$plot)
set.seed(1)#
x <- rep(NA, 50)#
x[1] <- rnorm(1)#
#
v <- rnorm(50)#
#
for(i in 2:length(x)) {#
	x[i] <- x[i-1]*1.02 + v[i]#
}#
#
dx <- dshift(x)#
ldx <- lshift(dx, 1)#
#
d2x <- dshift(dx)#
ld2x <- lshift(d2x, 1)#
#
u <- rnorm(50)#
y <- dy <- rep(NA, length(x))#
#
y[1:2] <- rnorm(2)#
#
for(i in 3:length(dy)) {#
	dy[i] <- dx[i]*rnorm(1, 1, 1) + ldx[i]*rnorm(1, 0.1, 0.3) + u[i]#
	y[i] <- y[i-1] + dy[i]#
}#
#
ly <- lshift(y, 1)#
lx <- lshift(x, 1)#
#
dy <- dshift(y)#
ldy <- lshift(dy, 1)#
#
d2y <- dshift(dy)#
ld2y <- lshift(d2y, 1)#
small4 <- data.frame(x = x, dx = dx, ldx = ldx, lx = lx,#
					y = y, dy = dy, ldy = ldy, ly = ly,#
					d2x = d2x, ld2x = ld2x,#
					d2y = d2y, ld2y = ld2y)#
#
small4 <- small4[5:50,]#
small4#
#
######################
# GECM(1,1), levels#
######################
#
model <- lm(dy ~ ly + lx + ldy + dx + ldx, data = small4)#
summary(model)#
#
test.gecm.levels.levels.pulse <- GDRF.gecm.plot(model = model, #
				x.vrbl = c("lx" = 1), y.vrbl = c("ly" = 1),#
				x.vrbl.d.x = 0, y.vrbl.d.y = 0,#
				x.d.vrbl = c("dx" = 0, "ldx" = 1), y.d.vrbl = c("ldy" = 1),#
				x.d.vrbl.d.x = 1,  y.d.vrbl.d.y = 1,#
				shock.history = "pulse", inferences.y = "levels", inferences.x = "levels",#
				s.limit = 2, return.plot = TRUE, return.formulae = TRUE)#
#
test.gecm.levels.levels.pulse$formulae#
test.gecm.levels.levels.pulse$plot#
#
