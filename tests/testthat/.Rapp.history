test_that("get.value returns correct values", {#
  model <- lm(y ~ l_1_y + x + l_1_x, data = toy.ts.interaction.data)#
#
  expect_equal( # user-supplied value is returned directly#
    # Function output#
    get.value(var = "x", prediction.values = list("x" = 5), model = model),#
#
    # Expected output#
    5#
  )#
#
  expect_equal( # user-supplied value of 0 is returned (not treated as missing)#
    # Function output#
    get.value(var = "x", prediction.values = list("x" = 0), model = model),#
#
    # Expected output#
    0#
  )#
#
  expect_warning( # variable not in prediction.values: mean used and warning issued#
    # Function output#
    get.value(var = "x", prediction.values = list(), model = model),#
#
    # Expected output#
    "x not in `prediction.values`; mean of series used"#
  )#
#
  expect_equal( # variable not in prediction.values: correct mean returned#
    # Function output#
    suppressWarnings(get.value(var = "x", prediction.values = list(), model = model)),#
#
    # Expected output#
    mean(model.frame(model)[["x"]], na.rm = TRUE)#
  )#
#
  expect_warning( # NA in prediction.values: mean used and warning issued#
    # Function output#
    get.value(var = "x", prediction.values = list("x" = NA), model = model),#
#
    # Expected output#
    "x not in `prediction.values`; mean of series used"#
  )#
#
  expect_equal( # NA in prediction.values: correct mean returned#
    # Function output#
    suppressWarnings(get.value(var = "x", prediction.values = list("x" = NA), model = model)),#
#
    # Expected output#
    mean(model.frame(model)[["x"]], na.rm = TRUE)#
  )#
#
  expect_equal( # correct mean returned for a different variable#
    # Function output#
    suppressWarnings(get.value(var = "l_1_x", prediction.values = list(), model = model)),#
#
    # Expected output#
    mean(model.frame(model)[["l_1_x"]], na.rm = TRUE)#
  )#
#
  expect_equal( # user-supplied value takes precedence over model mean#
    # Function output#
    get.value(var = "x", prediction.values = list("x" = 99), model = model),#
#
    # Expected output#
    99#
  )#
})
test_that("inference.adjustr returns correct d values for plotting and calculation", {#
#
  # output is a list with four elements#
  expect_equal(#
    # Function output#
    names(inference.adjustr(inferences.y = "levels", inferences.x = "levels",#
                            the.d.y = 1, the.d.x = 1)),#
#
    # Expected output#
    c("calc.d.y", "calc.d.x", "plot.d.y", "plot.d.x")#
  )#
#
  # inferences.y = "levels": calc.d.y equals the.d.y, plot.d.y equals 0#
  expect_equal(#
    # Function output#
    inference.adjustr(inferences.y = "levels", inferences.x = "levels",#
                      the.d.y = 1, the.d.x = 0)$calc.d.y,#
#
    # Expected output#
    1#
  )#
#
  expect_equal(#
    # Function output#
    inference.adjustr(inferences.y = "levels", inferences.x = "levels",#
                      the.d.y = 1, the.d.x = 0)$plot.d.y,#
#
    # Expected output#
    0#
  )#
#
  # inferences.y = "differences": calc.d.y equals 0, plot.d.y equals the.d.y#
  expect_equal(#
    # Function output#
    inference.adjustr(inferences.y = "differences", inferences.x = "levels",#
                      the.d.y = 1, the.d.x = 0)$calc.d.y,#
#
    # Expected output#
    0#
  )#
#
  expect_equal(#
    # Function output#
    inference.adjustr(inferences.y = "differences", inferences.x = "levels",#
                      the.d.y = 1, the.d.x = 0)$plot.d.y,#
#
    # Expected output#
    1#
  )#
#
  # inferences.x = "levels": calc.d.x equals the.d.x, plot.d.x equals 0#
  expect_equal(#
    # Function output#
    inference.adjustr(inferences.y = "levels", inferences.x = "levels",#
                      the.d.y = 0, the.d.x = 1)$calc.d.x,#
#
    # Expected output#
    1#
  )#
#
  expect_equal(#
    # Function output#
    inference.adjustr(inferences.y = "levels", inferences.x = "levels",#
                      the.d.y = 0, the.d.x = 1)$plot.d.x,#
#
    # Expected output#
    0#
  )#
#
  # inferences.x = "differences": calc.d.x equals 0, plot.d.x equals the.d.x#
  expect_equal(#
    # Function output#
    inference.adjustr(inferences.y = "levels", inferences.x = "differences",#
                      the.d.y = 0, the.d.x = 1)$calc.d.x,#
#
    # Expected output#
    0#
  )#
#
  expect_equal(#
    # Function output#
    inference.adjustr(inferences.y = "levels", inferences.x = "differences",#
                      the.d.y = 0, the.d.x = 1)$plot.d.x,#
#
    # Expected output#
    1#
  )#
#
  # both in levels: calc values equal the.d values, plot values equal 0#
  expect_equal(#
    # Function output#
    inference.adjustr(inferences.y = "levels", inferences.x = "levels",#
                      the.d.y = 1, the.d.x = 1)$calc.d.y,#
#
    # Expected output#
    1#
  )#
#
  expect_equal(#
    # Function output#
    inference.adjustr(inferences.y = "levels", inferences.x = "levels",#
                      the.d.y = 1, the.d.x = 1)$calc.d.x,#
#
    # Expected output#
    1#
  )#
#
  expect_equal(#
    # Function output#
    inference.adjustr(inferences.y = "levels", inferences.x = "levels",#
                      the.d.y = 1, the.d.x = 1)$plot.d.y,#
#
    # Expected output#
    0#
  )#
#
  expect_equal(#
    # Function output#
    inference.adjustr(inferences.y = "levels", inferences.x = "levels",#
                      the.d.y = 1, the.d.x = 1)$plot.d.x,#
#
    # Expected output#
    0#
  )#
#
  # both in differences: calc values equal 0, plot values equal the.d values#
  expect_equal(#
    # Function output#
    inference.adjustr(inferences.y = "differences", inferences.x = "differences",#
                      the.d.y = 1, the.d.x = 1)$calc.d.y,#
#
    # Expected output#
    0#
  )#
#
  expect_equal(#
    # Function output#
    inference.adjustr(inferences.y = "differences", inferences.x = "differences",#
                      the.d.y = 1, the.d.x = 1)$calc.d.x,#
#
    # Expected output#
    0#
  )#
#
  expect_equal(#
    # Function output#
    inference.adjustr(inferences.y = "differences", inferences.x = "differences",#
                      the.d.y = 1, the.d.x = 1)$plot.d.y,#
#
    # Expected output#
    1#
  )#
#
  expect_equal(#
    # Function output#
    inference.adjustr(inferences.y = "differences", inferences.x = "differences",#
                      the.d.y = 1, the.d.x = 1)$plot.d.x,#
#
    # Expected output#
    1#
  )#
#
  # d values of 0: levels inference returns 0 for both calc and plot#
  expect_equal(#
    # Function output#
    inference.adjustr(inferences.y = "levels", inferences.x = "levels",#
                      the.d.y = 0, the.d.x = 0)$calc.d.y,#
#
    # Expected output#
    0#
  )#
#
  expect_equal(#
    # Function output#
    inference.adjustr(inferences.y = "levels", inferences.x = "levels",#
                      the.d.y = 0, the.d.x = 0)$plot.d.y,#
#
    # Expected output#
    0#
  )#
#
  # mixed: inferences.y = "levels", inferences.x = "differences"#
  expect_equal(#
    # Function output#
    inference.adjustr(inferences.y = "levels", inferences.x = "differences",#
                      the.d.y = 1, the.d.x = 1)$calc.d.y,#
#
    # Expected output#
    1#
  )#
#
  expect_equal(#
    # Function output#
    inference.adjustr(inferences.y = "levels", inferences.x = "differences",#
                      the.d.y = 1, the.d.x = 1)$calc.d.x,#
#
    # Expected output#
    0#
  )#
#
  expect_equal(#
    # Function output#
    inference.adjustr(inferences.y = "levels", inferences.x = "differences",#
                      the.d.y = 1, the.d.x = 1)$plot.d.y,#
#
    # Expected output#
    0#
  )#
#
  expect_equal(#
    # Function output#
    inference.adjustr(inferences.y = "levels", inferences.x = "differences",#
                      the.d.y = 1, the.d.x = 1)$plot.d.x,#
#
    # Expected output#
    1#
  )#
#
})
# Skip if [PACKAGE] is not installed #
skip_if_not_installed("ARDL")#
#
# Run the model#
model.ardl <- ardl(y ~ x + z, data = toy.ts.interaction.data, order = c(1, 2, 2))#
#
######################################################################
# check.model.class#
######################################################################
#
test_that("check.model.class returns correct values (ardl)", {#
#
  # Store results for testing#
  ardl.class <- check.model.class(model.ardl)#
  expect_equal( # the class is correct#
    # Function output#
    ardl.class$model.class,#
    # Expected output#
    "ardl"#
  )#
  expect_equal( # the class is supported#
    # Function output#
    ardl.class$supported,#
    # Expected output#
    TRUE#
  )#
#
  expect_equal( # the class is not panel#
    # Function output#
    ardl.class$is.panel,#
    # Expected output#
    FALSE#
  )#
#
  expect_equal( # the class is not glm#
    # Function output#
    ardl.class$is.glm,#
    # Expected output#
    FALSE#
  )#
#
  expect_equal( # the class is not a wrapper#
    # Function output#
    ardl.class$is.wrapper,#
    # Expected output#
    FALSE#
  )#
#
  expect_equal( # the link function is identity#
    # Function output#
    ardl.class$link.fn,#
    # Expected output#
    "identity"#
  )#
#
})#
