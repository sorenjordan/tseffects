                    y.d.vrbl.d.y = 1,#
                    te.type = "pte", #
                    inferences.y = "levels", #
                    inferences.x = "levels",#
                    h.limit = 2, #
                    return.plot = TRUE, #
                    return.formulae = TRUE),#
    # Expected output#
