                    x.vrbl.d.x = 0, #
                    y.vrbl.d.y = 0,#
                    x.d.vrbl = c("d.x" = 0, "l.1.d.x" = 1), #
                    y.d.vrbl = c("l.1.d.y" = 1),#
                    x.d.vrbl.d.x = 1, #
                    y.d.vrbl.d.y = 1,#
                    te.type = "pte", #
