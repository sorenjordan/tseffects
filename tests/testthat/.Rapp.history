test_that("check.model.class returns correct values (generic)", {#
  model.lm <- lm(y ~ l_1_y + x + l_1_x, data = toy.ts.interaction.data)#
#
  # Store results for testing#
  lm.class <- check.model.class(model.lm)#
  expect_equal( # the class is correct#
    # Function output#
    lm.class$model.class,#
    # Expected output#
    "lm"#
  )#
  expect_equal( # the class is supported#
    # Function output#
    lm.class$supported,#
    # Expected output#
    TRUE#
  )#
#
  expect_equal( # the class is not panel#
    # Function output#
    lm.class$is.panel,#
    # Expected output#
    FALSE#
  )#
#
  expect_equal( # the class is not glm#
    # Function output#
    lm.class$is.glm,#
    # Expected output#
    FALSE#
  )#
#
  expect_equal( # the class is not a wrapper#
    # Function output#
    lm.class$is.wrapper,#
    # Expected output#
    FALSE#
  )#
#
  expect_equal( # the link function is identity#
    # Function output#
    lm.class$link.fn,#
    # Expected output#
    "identity"#
  )#
#
})
test_that("check.model.class returns a list with correct structure", { #
#
  # Fit a simple lm model #
  model <- lm(y ~ x, data = toy.ts.interaction.data)  #
  # Function output #
  result <- check.model.class(model)  #
  expect_true(is.list(result)) # it's a list with elements and names#
  expect_named( # the list names are corrected#
    # Function output#
    result, #
    # Expected output#
    c("model.class", "supported", "is.panel", "is.glm",  "is.wrapper", "link.fn")#
  )#
})
test_that("check.model.class rejects non-model objects", { #
#
  # force-feed not-a-model#
  expect_error(#
    # Function output #
    check.model.class(data.frame(x = 1:5, y = 1:5)), #
    # Expected output#
    "does not appear to be a fitted model"#
  ) #
})
test_that("check.model.class warns on untested but supported models", { #
#
  # Fit a simple lm model #
  model <- lm(y ~ x, data = toy.ts.interaction.data)  #
  # Temporarily modify class to simulate untested model #
  class(model) <- c("untested_model", "lm")  #
  # force-feed bad class#
  expect_warning(#
    # Function output#
    check.model.class(model), #
    # Expected output#
    "has not been explicitly tested in tseffects"#
  )#
})
test_that("check.model.class warns on untested but supported models", { #
#
  # Fit a simple lm model #
  model <- lm(y ~ x, data = toy.ts.interaction.data)  #
  # Temporarily modify class to simulate untested model #
  class(model) <- c("untested_model", "lm")  #
  # force-feed bad class#
  expect_warning(#
    # Function output#
    check.model.class(model), #
    # Expected output#
    "has not been explicitly tested in `tseffects`"#
  )#
})
test_that("check.model.class warns models with non-identity link functions", { #
#
  # Fit a glm model with logit link #
  model <- glm(as.numeric(y > median(y)) ~ x,  family = binomial(link = "logit"), data = toy.ts.interaction.data)  #
  ##
  expect_warning(#
    # Function output#
    check.model.class(model), #
    # Expected output#
    "no adjustment to effect calculations"#
  ) #
})
test_that("convolution.calculator generates correct equations (pulse treatments)", {#
  x.lags <- c("x" = 0, "l_1_x" = 1)#
  y.lags <- c("l_1_y" = 1)#
  s <- 5#
  s.test <- 3#
#
  pte.test <- pulse.calculator(x.vrbl = x.lags, y.vrbl = y.lags, limit = s)#
  # pulse shock in levels: one-time impulse#
  pulse.shocks <- c(1, 0, 0, 0, 0, 0)#
#
  #####################################################################################
  # ADL(1,1), both variables in levels, pulse, testing if matches for s = 3#
  #####################################################################################
  d.x <- 0#
  d.y <- 0#
#
  conv.test <- convolution.calculator(d.x = d.x, d.y = d.y, shocks = pulse.shocks, pulses = pte.test)#
#
  expect_equal( # test whether formula matches for s = 3#
    # Function output#
    # Increment s.test because counter starts at s = 0#
    print(conv.test$formulae[[s.test+1]]),#
    # Expected output#
    "l_1_y**2 * l_1_x  +  l_1_y**3 * x "#
  )#
#
  expect_equal( # test whether shocks are as expected for s = 3#
    # Function output#
    # Increment s.test because counter starts at s = 0#
    conv.test$shocks[[s.test+1]],#
    # Expected output#
    # d.x = 0: no translation, shocks stay c(1,0,0,0)#
    c(1, 0, 0, 0)#
  )#
#
  expect_equal( # test whether the correct number of formulae have been produced#
    # Function output#
    length(conv.test$formulae), # counter goes from s = 0 to s = 5#
    # Expected output#
    s+1#
  )#
#
  expect_equal( # test whether the correct number of shock lists have been produced#
    # Function output#
    length(conv.test$shocks), # counter goes from s = 0 to s = 5#
    # Expected output#
    s+1#
  )#
#
  #####################################################################################
  # ADL(1,1), differenced x, levels y, pulse, testing if matches for s = 3#
  #####################################################################################
  d.x <- 1#
  d.y <- 0#
#
  conv.test <- convolution.calculator(d.x = d.x, d.y = d.y, shocks = pulse.shocks, pulses = pte.test)#
#
  expect_equal( # test whether formula matches for s = 3#
    # Function output#
    # Increment s.test because counter starts at s = 0#
    print(conv.test$formulae[[s.test+1]]),#
    # Expected output#
    "l_1_y**2 * l_1_x  +  l_1_y**3 * x  -  l_1_y * l_1_x  -  l_1_y**2 * x "#
  )#
#
  expect_equal( # test whether shocks are as expected for s = 3#
    # Function output#
    # Increment s.test because counter starts at s = 0#
    conv.test$shocks[[s.test+1]],#
    # Expected output#
    # d.x = 1: diff() of c(1,0,0,0) = c(1,-1,0,0)#
    c(1, -1, 0, 0)#
  )#
#
  expect_equal( # test whether the correct number of formulae have been produced#
    # Function output#
    length(conv.test$formulae), # counter goes from s = 0 to s = 5#
    # Expected output#
    s+1#
  )#
#
  expect_equal( # test whether the correct number of shock lists have been produced#
    # Function output#
    length(conv.test$shocks), # counter goes from s = 0 to s = 5#
    # Expected output#
    s+1#
  )#
#
  #####################################################################################
  # ADL(1,1), levels x, differenced y, pulse, testing if matches for s = 3#
  #####################################################################################
  d.x <- 0#
  d.y <- 1#
#
  conv.test <- convolution.calculator(d.x = d.x, d.y = d.y, shocks = pulse.shocks, pulses = pte.test)#
#
  expect_equal( # test whether formula matches for s = 3#
    # Function output#
