                                shock.history = "pulse", #
                                inferences.y = "levels", #
                                inferences.x = "levels",#
                                s.limit = the.s, #
                                return.plot = TRUE, #
                                return.formulae = TRUE,#
                                return.data = TRUE))#
  model_test_ste <- GDRF.gecm.plot(model = model, #
                                    x.vrbl = c("l_1_x" = 1), #
