library(mpoly)#
library(car)#
library(ggplot2)#
library(see)#
library(colorspace)#
library(stats)#
library(sandwich)#
library(utils)#
#
# required for tester#
library(testthat)#
library(vdiffr)#
#
# For Soren#
source("/Users/sorenjordan/Dropbox/Garrett-Soren/tseffects/tseffects/tseffects-nextversion-beta.R")#
load("/Users/sorenjordan/Dropbox/Garrett-Soren/tseffects/tseffects/data/approval.rda")#
load("/Users/sorenjordan/Dropbox/Garrett-Soren/tseffects/tseffects/data/toy.ts.interaction.data.rda")
source("/Users/sorenjordan/Dropbox/Garrett-Soren/tseffects/tseffects-nextversion-beta.R")
model <- lm(d_y ~ l_1_y + l_1_x + l_1_d_y + d_x + l_1_d_x, data = toy.ts.interaction.data)#
#
  result.marginal <- GDRF.gecm.plot(model = model,#
                                    x.vrbl = c("l_1_x" = 1),#
                                    y.vrbl = c("l_1_y" = 1),#
                                    x.vrbl.d.x = 0,#
                                    y.vrbl.d.y = 0,#
                                    x.d.vrbl = c("d_x" = 0, "l_1_d_x" = 1),#
                                    y.d.vrbl = c("l_1_d_y" = 1),#
                                    x.d.vrbl.d.x = 1,#
                                    y.d.vrbl.d.y = 1,#
                                    shock.history = "pulse",#
                                    inferences.y = "levels",#
                                    inferences.x = "levels",#
                                    effect.type = "marginal",#
                                    s.limit = 5,#
                                    return.plot = FALSE,#
                                    return.formulae = FALSE,#
                                    return.data = TRUE)
result.fitted <- GDRF.gecm.plot(model = model,#
                                  x.vrbl = c("l_1_x" = 1),#
                                  y.vrbl = c("l_1_y" = 1),#
                                  x.vrbl.d.x = 0,#
                                  y.vrbl.d.y = 0,#
                                  x.d.vrbl = c("d_x" = 0, "l_1_d_x" = 1),#
                                  y.d.vrbl = c("l_1_d_y" = 1),#
                                  x.d.vrbl.d.x = 1,#
                                  y.d.vrbl.d.y = 1,#
                                  shock.history = "pulse",#
                                  inferences.y = "levels",#
                                  inferences.x = "levels",#
                                  effect.type = "fitted",#
                                  baseline.y = 5,#
                                  shock.size = 1,#
                                  s.limit = 5,#
                                  return.plot = FALSE,#
                                  return.formulae = FALSE,#
                                  return.data = TRUE)
expect_false( # fitted and marginal estimates should differ
expect_false( # fitted and marginal estimates should differ#
#
    # Function output#
    identical(result.marginal$GDRF, result.fitted$GDRF)#
  )
expect_equal( # fitted values offset from marginal by baseline.y#
    # Function output#
    result.fitted$GDRF - result.marginal$GDRF,#
    # Expected output#
    rep(5, nrow(result.marginal)),#
    tolerance = 1e-6#
  )
result.fitted$GDRF
result.marginal$GDRF
result.fitted$GDRF - result.marginal$GDRF
result.fitted
expect_equal( # SE should be unchanged when baseline.y.se = 0#
    # Function output#
    result.fitted$SE,#
#
    # Expected output#
    result.marginal$SE,#
    tolerance = 1e-6#
  )
result.fitted$GDRF[2:6] - result.marginal$GDRF
result.fitted$GDRF[2:6]
result.fitted$GDRF[2:7] - result.marginal$GDRF
expect_equal( # fitted values offset from marginal by baseline.y#
    # Function output#
    result.fitted$GDRF[2:7] - result.marginal$GDRF,#
    # Expected output#
    rep(5, nrow(result.marginal)),#
    tolerance = 1e-6#
  )
result.fitted$SE
result.marginal$SE
