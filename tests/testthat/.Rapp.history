    # Function#
    names(lines.cumulative.dat),#
#
    # Expected output#
    c("Period", "Z", "Effect", "SE", "Lower", "Upper")#
  ) #
#
  expect_equal( # cumulative, lines#
    # Function#
    dim(lines.cumulative.dat),#
#
