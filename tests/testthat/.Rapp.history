                   y.vrbl = c("l_1_y" = 1), #
                   z.vrbl = c("z" = 0, "l_1_z" = 1),#
                   x.z.vrbl = c("x_z" = 0, "z_l_1_x" = 1, "x_l_1_z" = 0, "l_1_x_l_1_z" = 1),#
                   plot.type = "lines",#
                   line.options = "s.lines",#
                   z.vals = c(0, 1),#
                   return.plot = FALSE, #
                   return.data = TRUE)$Z),#
#
