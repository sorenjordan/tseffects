test_that("Numeric correctness for custom shock history at s = 2 (interact.adl.plot)", {#
  model <- lm(y ~ l_1_y + x + l_1_x + x:z + l_1_x:z,#
              data = toy.ts.interaction.data)#
#
  # Coefficient building blocks#
  b_ly  <- unname(coef(model)["l_1_y"])#
  b_x   <- unname(coef(model)["x"])#
  b_lx  <- unname(coef(model)["l_1_x"])#
  b_xz  <- unname(coef(model)["x:z"])#
  b_lxz <- unname(coef(model)["l_1_x:z"])#
#
  # With d.y = 0, d.x = 0: phi_1 is just the AR coefficient#
  phi_1 <- b_ly#
#
  # Effective x coefficients at z_val = 1#
  z_val    <- 1#
  eff_om_0 <- b_x  + b_xz  * z_val#
  eff_om_1 <- b_lx + b_lxz * z_val#
#
  # Custom shock history: shock[0] = 1, shock[1] = 0, shock[2] = 1#
  # D(0) = eff_om_0 * 1#
  # D(1) = phi_1 * D(0) + eff_om_0 * 0 + eff_om_1 * 1#
  # D(2) = phi_1 * D(1) + eff_om_0 * 1 + eff_om_1 * 0#
  #      = phi_1 * (phi_1 * eff_om_0 + eff_om_1) + eff_om_0#
  # Note: eff_om_1 drops out at s = 2 because shock[1] = 0 —#
  # a meaningful check that shock indexing is handled correctly#
  D_0 <- eff_om_0#
  D_1 <- phi_1 * D_0 + eff_om_1#
  D_2 <- phi_1 * D_1 + eff_om_0#
#
  #####################################################################################
  # effect.type = "discrete", shock.size = 1#
  #####################################################################################
  result.discrete <- interact.adl.plot(model = model,#
                                        x.vrbl = c("x" = 0, "l_1_x" = 1),#
                                        y.vrbl = c("l_1_y" = 1),#
                                        z.vrbl = "z",#
                                        z.value = z_val,#
                                        d.x = 0, d.y = 0,#
                                        shock.history = c(1, 0, 1),#
                                        inferences.y = "levels",#
                                        inferences.x = "levels",#
                                        effect.type = "discrete",#
                                        shock.size = 1,#
                                        s.limit = 2,#
                                        return.plot = FALSE,#
                                        return.formulae = FALSE,#
                                        return.data = TRUE)#
#
  expect_equal( # s = 2 discrete: phi_1 * (phi_1 * eff_om_0 + eff_om_1) + eff_om_0#
    #           eff_om_1 drops out because shock[1] = 0#
    # Function output#
    result.discrete$GDRF[result.discrete$Period == "s = 2"],#
    # Expected output#
    D_2,#
    tolerance = 1e-6#
  )#
  expect_equal( # s = 1 discrete: phi_1 * eff_om_0 + eff_om_1#
    #           shock[1] = 0 so eff_om_0 drops out at s = 1#
    # Function output#
    result.discrete$GDRF[result.discrete$Period == "s = 1"],#
    # Expected output#
    D_1,#
    tolerance = 1e-6#
  )#
  expect_equal( # s = 0 discrete: eff_om_0 * shock[0] = eff_om_0#
    # Function output#
    result.discrete$GDRF[result.discrete$Period == "s = 0"],#
    # Expected output#
    D_0,#
    tolerance = 1e-6#
  )#
#
  #####################################################################################
  # effect.type = "fitted", baseline.y = 5, shock.size = 1#
  # G(s) = baseline.y + D(s)#
  #####################################################################################
  result.fitted <- interact.adl.plot(model = model,#
                                      x.vrbl = c("x" = 0, "l_1_x" = 1),#
                                      y.vrbl = c("l_1_y" = 1),#
                                      z.vrbl = "z",#
                                      z.value = z_val,#
                                      d.x = 0, d.y = 0,#
                                      shock.history = c(1, 0, 1),#
                                      inferences.y = "levels",#
                                      inferences.x = "levels",#
                                      effect.type = "fitted",#
                                      baseline.y = 5,#
                                      shock.size = 1,#
                                      s.limit = 2,#
                                      return.plot = FALSE,#
                                      return.formulae = FALSE,#
                                      return.data = TRUE)#
#
  expect_equal( # s = 2 fitted: baseline.y + D(2)#
    # Function output#
    result.fitted$GDRF[result.fitted$Period == "s = 2"],#
    # Expected output#
    5 + D_2,#
    tolerance = 1e-6#
  )#
  expect_equal( # s = 1 fitted: baseline.y + D(1)#
    # Function output#
    result.fitted$GDRF[result.fitted$Period == "s = 1"],#
    # Expected output#
    5 + D_1,#
    tolerance = 1e-6#
  )#
  expect_equal( # s = 0 fitted: baseline.y + D(0)#
    # Function output#
    result.fitted$GDRF[result.fitted$Period == "s = 0"],#
    # Expected output#
    5 + D_0,#
    tolerance = 1e-6#
  )#
  expect_equal( # fitted and discrete GDRFs differ by exactly baseline.y at every period#
    # Function output#
    result.fitted$GDRF[result.fitted$Period != "baseline"] -#
      result.discrete$GDRF,#
    # Expected output#
    rep(5, nrow(result.discrete)),#
    tolerance = 1e-6#
  )#
})
model <- lm(y ~ l_1_y + x + l_1_x + x:z + l_1_x:z,#
              data = toy.ts.interaction.data)#
#
  # Coefficient building blocks#
  b_ly  <- unname(coef(model)["l_1_y"])#
  b_x   <- unname(coef(model)["x"])#
  b_lx  <- unname(coef(model)["l_1_x"])#
  b_xz  <- unname(coef(model)["x:z"])#
  b_lxz <- unname(coef(model)["l_1_x:z"])#
#
  # With d.y = 0, d.x = 0: phi_1 is just the AR coefficient#
  phi_1 <- b_ly#
#
  # Effective x coefficients at z_val = 1#
  z_val    <- 1#
  eff_om_0 <- b_x  + b_xz  * z_val#
  eff_om_1 <- b_lx + b_lxz * z_val#
#
  # Custom shock history: shock[0] = 1, shock[1] = 0, shock[2] = 1#
  # D(0) = eff_om_0 * 1#
  # D(1) = phi_1 * D(0) + eff_om_0 * 0 + eff_om_1 * 1#
  # D(2) = phi_1 * D(1) + eff_om_0 * 1 + eff_om_1 * 0#
  #      = phi_1 * (phi_1 * eff_om_0 + eff_om_1) + eff_om_0#
  # Note: eff_om_1 drops out at s = 2 because shock[1] = 0 —#
  # a meaningful check that shock indexing is handled correctly#
  D_0 <- eff_om_0#
  D_1 <- phi_1 * D_0 + eff_om_1#
  D_2 <- phi_1 * D_1 + eff_om_0#
#
  #####################################################################################
  # effect.type = "discrete", shock.size = 1#
  #####################################################################################
  result.discrete <- interact.adl.plot(model = model,#
                                        x.vrbl = c("x" = 0, "l_1_x" = 1),#
                                        y.vrbl = c("l_1_y" = 1),#
                                        z.vrbl = "z",#
                                        z.value = z_val,#
                                        d.x = 0, d.y = 0,#
                                        shock.history = c(1, 0, 1),#
                                        inferences.y = "levels",#
                                        inferences.x = "levels",#
                                        effect.type = "discrete",#
                                        shock.size = 1,#
                                        s.limit = 2,#
                                        return.plot = FALSE,#
                                        return.formulae = FALSE,#
                                        return.data = TRUE)
