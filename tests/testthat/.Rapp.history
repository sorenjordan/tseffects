	      x.vrbl = c("x" = 0), z.vrbl = c("z" = 0),#
	      x.z.vrbl = c("x_z" = 0), y.vrbl = c("l_1_y" = 1),#
	      shock.history = "impulse",#
	      cumulative = FALSE,#
	      effect.type = "fitted",#
	      prediction.values = list("x" = 0, "x_z" = 0),#
	      baseline.y = 50,#
	      z.vals = 1,#
	      s.limit = 5,#
	      return.plot = FALSE, return.data = TRUE, return.formulae = FALSE),#
#
	    # Expected output#
