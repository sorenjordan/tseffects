  )#
  expect_error( # x.d.vrbl vrbl vector has no values#
    # Function output#
    GDRF.gecm.plot(model = model.gecm,#
                   x.vrbl = c("l_1_x" = 1),#
                   y.vrbl = c("l_1_y" = 1),#
