                   shock.history = "impulse",#
                   z.vals = c(0, 1),#
                   s.limit = 10,#
                   return.plot = FALSE, return.data = FALSE, return.formulae = FALSE)),#
    # Expected error#
    "Return at least one of the plot, the data"#
  )#
