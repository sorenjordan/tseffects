test_that("Fitted values evaluated are correct (d.x = 0; d.y = 0)", { #
  model <- lm(d_y ~ l_1_d_y + x + l_1_d_x, data = toy.ts.interaction.data)#
#
  #####################################################################################
  # ADL(1,1), both inferences in levels, pulse and step#
  ####################################################################################  #
  model_test_pulse_pred <- suppressWarnings(GDRF.adl.plot(model = model, #
                               x.vrbl = c("x" = 0, "l_1_d_x" = 1), #
                               y.vrbl = c("l_1_d_y" = 1),#
                               d.x = 0, #
                               d.y = 0,                               	#
                               shock.history = "pulse", #
                               inferences.y = "levels", inferences.x = "levels", #
                               effect.type = "fitted", prediction.values = list("x" = 1, "l_1_d_x" = 1), shock.size = 2,#
                               s.limit = 3, #
                               return.plot = FALSE,#
                               return.formulae = TRUE, return.data = TRUE))#
  expect_equal( # baseline should just be the plain steady-state#
    # Function output#
    model_test_pulse_pred$estimates$GDRF[model_test_pulse_pred$estimates$Period == "baseline"],#
#
    # Expected output:#
    unname((coef(model)["(Intercept)"] + #
    	coef(model)["x"] * 1 + #
    	coef(model)["l_1_d_x"] * 1)/(1 - coef(model)["l_1_d_y"])),#
    tolerance = 1e-6#
  )#
#
  expect_equal( # period 0 is the initial (scaled) shock#
    # Function output#
    model_test_pulse_pred$estimates$GDRF[model_test_pulse_pred$estimates$Period == "0"],#
#
    # Expected output:#
    unname((coef(model)["(Intercept)"] + #
    	coef(model)["x"] * 1 + #
    	coef(model)["l_1_d_x"] * 1)/(1 - coef(model)["l_1_d_y"]) +#
    		coef(model)["x"]*2#
    	),#
    tolerance = 1e-6#
  )#
#
  expect_equal( # period 1 is the scaled shock + deteriorating old one#
    # Function output#
    model_test_pulse_pred$estimates$GDRF[model_test_pulse_pred$estimates$Period == "1"],#
#
    # Expected output:#
    unname((coef(model)["(Intercept)"] + #
    	coef(model)["x"] * 1 + #
    	coef(model)["l_1_d_x"] * 1)/(1 - coef(model)["l_1_d_y"]) +#
    		coef(model)["x"]*2*coef(model)["l_1_d_y"] +#
    		coef(model)["l_1_d_x"]*2#
    	),#
    tolerance = 1e-6#
  )#
#
  model_test_pulse_means <- suppressWarnings(GDRF.adl.plot(model = model, #
                               x.vrbl = c("x" = 0, "l_1_d_x" = 1), #
                               y.vrbl = c("l_1_d_y" = 1),#
                               d.x = 0, #
                               d.y = 0,                               	#
                               shock.history = "pulse", #
                               inferences.y = "levels", inferences.x = "levels", #
                               effect.type = "fitted", prediction.values = list("x" = 1), shock.size = 2,#
                               s.limit = 3, #
                               return.plot = FALSE,#
                               return.formulae = TRUE, return.data = TRUE))#
  expect_equal( # baseline should just be the plain steady-state#
    # Function output#
    model_test_pulse_means$estimates$GDRF[model_test_pulse_means$estimates$Period == "baseline"],#
#
    # Expected output:#
    unname((coef(model)["(Intercept)"] + #
    	coef(model)["x"] * 1 + #
    	coef(model)["l_1_d_x"] * mean(toy.ts.interaction.data$l_1_d_x, na.rm = TRUE))/(1 - coef(model)["l_1_d_y"])),#
    tolerance = 1e-6#
  )#
#
  expect_equal( # period 0 is the initial (scaled) shock#
    # Function output#
    model_test_pulse_means$estimates$GDRF[model_test_pulse_means$estimates$Period == "0"],#
#
    # Expected output:#
    unname((coef(model)["(Intercept)"] + #
    	coef(model)["x"] * 1 + #
    	coef(model)["l_1_d_x"] * mean(toy.ts.interaction.data$l_1_d_x, na.rm = TRUE))/(1 - coef(model)["l_1_d_y"]) +#
    		coef(model)["x"]*2#
    	),#
    tolerance = 1e-6#
  )#
#
  expect_equal( # period 1 is the scaled shock + deteriorating old one#
    # Function output#
    model_test_pulse_means$estimates$GDRF[model_test_pulse_means$estimates$Period == "1"],#
#
    # Expected output:#
    unname((coef(model)["(Intercept)"] + #
    	coef(model)["x"] * 1 + #
    	coef(model)["l_1_d_x"] * mean(toy.ts.interaction.data$l_1_d_x, na.rm = TRUE))/(1 - coef(model)["l_1_d_y"]) +#
    		coef(model)["x"]*2*coef(model)["l_1_d_y"] +#
    		coef(model)["l_1_d_x"]*2#
    	),#
    tolerance = 1e-6#
  ) #
})
test_that("Correct dimensions of output", { #
  model <- lm(d_y ~ l_1_d_y + x + l_1_d_x, data = toy.ts.interaction.data)#
#
  # Three periods#
  the.s <- 3#
  model_test <- GDRF.adl.plot(model = model, #
                                x.vrbl = c("x" = 0, "l_1_d_x" = 1), #
                                y.vrbl = c("l_1_d_y" = 1),#
                                d.x = 2, #
                                d.y = 2,#
                                shock.history = "step", #
                                inferences.y = "levels", #
                                inferences.x = "levels",#
                                s.limit = the.s, #
                                return.plot = TRUE, #
                                return.formulae = TRUE,#
                                return.data = TRUE)#
  expect_equal( # test if the number of binomials is correct#
    # Function output#
    length(model_test$shocks),#
    # Expected output#
    # account for s = 0#
    the.s + 1#
  )#
  expect_equal( # test if the number of formulae is correct#
    # Function output#
    length(model_test$formulae),#
    # Expected output#
    # account for s = 0 and the LRM#
    the.s + 1 + 1#
  )  #
  expect_equal( # test the dimensions of the estimates#
    # Function output#
    dim(model_test$estimates),  #
#
    # Expected output#
    # rows is periods (limit + 1 for 0 + 1 for LRM), 5 columns (Period, GDTE, SE, Lower, Upper)#
    c(the.s + 1 + 1, 5),  #
  )#
#
  expect_equal( # test the names of the estimates#
    # Function output#
    names(model_test$estimates),  #
#
    # Expected output#
    # rows is periods (limit + 1 for 0), 5 columns (Period, GDTE, SE, Lower, Upper)#
    c("Period", "GDRF", "SE", "Lower", "Upper"),  #
  )#
})
test_that("Function returns objects correctly (including errors)", { #
  model <- lm(d_y ~ l_1_d_y + x + l_1_d_x, data = toy.ts.interaction.data)#
#
  expect_error( # No plot, estimates, formulae #
    # Function output#
    GDRF.adl.plot(model = model, #
                   x.vrbl = c("x" = 0, "l_1_d_x" = 1), #
                   y.vrbl = c("l_1_d_y" = 1),#
                   d.x = 2, #
                   d.y = 2,#
                   shock.history = "step", #
                   inferences.y = "levels", #
                   inferences.x = "levels",#
                   s.limit = 3, #
                   return.plot = FALSE, #
                   return.formulae = FALSE,#
                   return.data = FALSE),#
    # Expected error#
    "Return at least one of the plot, the data"#
  )#
  model_test_allthree <- GDRF.adl.plot(model = model, #
                                x.vrbl = c("x" = 0, "l_1_d_x" = 1), #
                                y.vrbl = c("l_1_d_y" = 1),#
                                d.x = 2, #
                                d.y = 2,#
                                shock.history = "step", #
                                inferences.y = "levels", #
                                inferences.x = "levels",#
                                s.limit = 3, #
                                return.plot = TRUE, #
                                return.formulae = TRUE,#
                                return.data = TRUE)#
#
  expect_true( # are all three objects returned?#
    # Function output#
    all(c("plot", "estimates", "formulae") %in% names(model_test_allthree))#
  )#
#
  model_test_justplot <- GDRF.adl.plot(model = model, #
                                x.vrbl = c("x" = 0, "l_1_d_x" = 1), #
                                y.vrbl = c("l_1_d_y" = 1),#
                                d.x = 2, #
                                d.y = 2,#
                                shock.history = "step", #
                                inferences.y = "levels", #
                                inferences.x = "levels",#
                                s.limit = 3, #
                                return.plot = TRUE, #
                                return.formulae = FALSE,#
                                return.data = FALSE)#
#
  expect_false( # is formulae or estimates returned?#
    # Function output#
    all(c("estimates", "formulae") %in% names(model_test_justplot))#
  )#
#
  model_test_noplot <- GDRF.adl.plot(model = model, #
                                x.vrbl = c("x" = 0, "l_1_d_x" = 1), #
                                y.vrbl = c("l_1_d_y" = 1),#
                                d.x = 2, #
                                d.y = 2,#
                                shock.history = "step", #
                                inferences.y = "levels", #
                                inferences.x = "levels",#
                                s.limit = 3, #
                                return.plot = FALSE, #
                                return.formulae = TRUE,#
                                return.data = TRUE)#
#
  expect_false( # is plot returned?#
    # Function output#
    all(c("plot") %in% names(model_test_noplot))#
  )#
#
  model_test_noformulae <- GDRF.adl.plot(model = model, #
                                x.vrbl = c("x" = 0, "l_1_d_x" = 1), #
                                y.vrbl = c("l_1_d_y" = 1),#
                                d.x = 2, #
                                d.y = 2,#
                                shock.history = "step", #
                                inferences.y = "levels", #
                                inferences.x = "levels",#
                                s.limit = 3, #
                                return.plot = TRUE, #
                                return.formulae = FALSE,#
                                return.data = TRUE)#
#
  expect_false( # is formulae returned?#
    all(c("formulae") %in% names(model_test_noformulae))#
  )#
  model_test_nodata <- GDRF.adl.plot(model = model, #
                                x.vrbl = c("x" = 0, "l_1_d_x" = 1), #
                                y.vrbl = c("l_1_d_y" = 1),#
                                d.x = 2, #
                                d.y = 2,#
                                shock.history = "step", #
                                inferences.y = "levels", #
                                inferences.x = "levels",#
                                s.limit = 3, #
                                return.plot = TRUE, #
                                return.formulae = TRUE,#
                                return.data = FALSE)#
#
  expect_false( # is data returned?#
    all(c("estimates") %in% names(model_test_nodata))#
  )#
#
  model_test_justdata <- GDRF.adl.plot(model = model, #
                                x.vrbl = c("x" = 0, "l_1_d_x" = 1), #
                                y.vrbl = c("l_1_d_y" = 1),#
                                d.x = 2, #
                                d.y = 2,#
                                shock.history = "step", #
                                inferences.y = "levels", #
                                inferences.x = "levels",#
                                s.limit = 3, #
                                return.plot = FALSE, #
                                return.formulae = FALSE,#
                                return.data = TRUE)#
#
  expect_false( # is data returned?#
    all(c("plot", "formulae") %in% names(model_test_justdata))#
  )#
})
test_that("GDRF.adl.plot y-axis labels are correct", {#
#
  model.adl   <- lm(y ~ l_1_y + x + l_1_x,     data = toy.ts.interaction.data)#
  model.diffs <- lm(d_y ~ l_1_d_y + x + l_1_x, data = toy.ts.interaction.data)#
#
  # discrete, pulse, cumulative = FALSE: GDRF[(s.limit, -1, plot.d.y, plot.d.x)]#
  result.disc.pulse <- suppressWarnings(#
    GDRF.adl.plot(model = model.adl,#
                  x.vrbl = c("x" = 0, "l_1_x" = 1),#
                  y.vrbl = c("l_1_y" = 1),#
                  d.x = 0, d.y = 0,#
                  shock.history = "pulse",#
                  inferences.y = "levels", inferences.x = "levels",#
                  effect.type = "discrete",#
                  cumulative = FALSE,#
                  s.limit = 5,#
                  return.plot = TRUE, return.formulae = FALSE, return.data = FALSE)#
  )#
#
  expect_true( # y-axis label contains GDRF#
    # Function output#
    grepl("GDRF", deparse(result.disc.pulse$labels$y))#
  )#
#
  expect_false( # y-axis label does not contain Cumulative for non-cumulative#
    # Function output#
    grepl("Cumulative", deparse(result.disc.pulse$labels$y))#
  )#
#
  # discrete, pulse, cumulative = TRUE: Cumulative GDRF#
  result.disc.pulse.cum <- GDRF.adl.plot(model = model.adl,#
                                          x.vrbl = c("x" = 0, "l_1_x" = 1),#
                                          y.vrbl = c("l_1_y" = 1),#
                                          d.x = 0, d.y = 0,#
                                          shock.history = "pulse",#
                                          inferences.y = "levels", inferences.x = "levels",#
                                          effect.type = "discrete",#
                                          cumulative = TRUE,#
                                          s.limit = 5,#
                                          return.plot = TRUE, return.formulae = FALSE, return.data = FALSE)#
#
  expect_true( # y-axis label contains Cumulative for cumulative#
    # Function output#
    grepl("Cumulative", deparse(result.disc.pulse.cum$labels$y))#
  )#
#
  # discrete, custom shock history, cumulative = FALSE: generic label#
  result.disc.custom <- GDRF.adl.plot(model = model.adl,#
                                       x.vrbl = c("x" = 0, "l_1_x" = 1),#
                                       y.vrbl = c("l_1_y" = 1),#
                                       d.x = 0, d.y = 0,#
                                       shock.history = c(1, 1, 1, 0, 0, 1),#
                                       inferences.y = "levels", inferences.x = "levels",#
                                       effect.type = "discrete",#
                                       cumulative = FALSE,#
                                       s.limit = 5,#
                                       return.plot = TRUE, return.formulae = FALSE, return.data = FALSE)#
#
  expect_true( # custom shock history produces generic label#
    # Function output#
    grepl("Discrete Effect of Shock History", deparse(result.disc.custom$labels$y))#
  )#
#
  # discrete, custom shock history, cumulative = TRUE: cumulative generic label#
  result.disc.custom.cum <- suppressWarnings(#
    GDRF.adl.plot(model = model.adl,#
                  x.vrbl = c("x" = 0, "l_1_x" = 1),#
                  y.vrbl = c("l_1_y" = 1),#
                  d.x = 0, d.y = 0,#
                  shock.history = c(1, 1, 1, 0, 0, 1),#
                  inferences.y = "levels", inferences.x = "levels",#
                  effect.type = "discrete",#
                  cumulative = TRUE,#
                  s.limit = 5,#
                  return.plot = TRUE, return.formulae = FALSE, return.data = FALSE)#
  )#
#
  expect_true( # custom + cumulative produces cumulative generic label#
    # Function output#
    grepl("Cumulative Discrete Effect of Shock History", deparse(result.disc.custom.cum$labels$y))#
  )#
#
  # fitted, step, cumulative = FALSE: Fitted Values label#
  result.fitted.step <- GDRF.adl.plot(model = model.adl,#
                                       x.vrbl = c("x" = 0, "l_1_x" = 1),#
                                       y.vrbl = c("l_1_y" = 1),#
                                       d.x = 0, d.y = 0,#
                                       shock.history = "step",#
                                       inferences.y = "levels", inferences.x = "levels",#
                                       effect.type = "fitted",#
                                       baseline.y = 5,#
                                       shock.size = 1,#
                                       cumulative = FALSE,#
                                       s.limit = 5,#
                                       return.plot = TRUE, return.formulae = FALSE, return.data = FALSE)#
#
  expect_true( # fitted label contains Fitted Values#
    # Function output#
    grepl("Fitted Values", deparse(result.fitted.step$labels$y))#
  )#
#
  expect_false( # fitted non-cumulative label does not contain Cumulative#
    # Function output#
    grepl("Cumulative", deparse(result.fitted.step$labels$y))#
  )#
#
  # fitted, custom shock, cumulative = TRUE: cumulative fitted generic label#
  result.fitted.custom.cum <- suppressWarnings(#
    GDRF.adl.plot(model = model.adl,#
                  x.vrbl = c("x" = 0, "l_1_x" = 1),#
                  y.vrbl = c("l_1_y" = 1),#
                  d.x = 0, d.y = 0,#
                  shock.history = c(1, 1, 1, 0, 0, 1),#
                  inferences.y = "levels", inferences.x = "levels",#
                  effect.type = "fitted",#
                  baseline.y = 5,#
                  shock.size = 1,#
                  cumulative = TRUE,#
                  s.limit = 5,#
                  return.plot = TRUE, return.formulae = FALSE, return.data = FALSE)#
  )#
#
  expect_true( # fitted + custom + cumulative produces cumulative fitted generic label#
    # Function output#
    grepl("Cumulative Fitted Values of Shock History", deparse(result.fitted.custom.cum$labels$y))#
  )#
#
})#
test_that("GDRF.adl.plot x-axis label is correct", {#
#
  model.adl <- lm(y ~ l_1_y + x + l_1_x, data = toy.ts.interaction.data)#
#
  result <- suppressWarnings(#
    GDRF.adl.plot(model = model.adl,#
                  x.vrbl = c("x" = 0, "l_1_x" = 1),#
                  y.vrbl = c("l_1_y" = 1),#
                  d.x = 0, d.y = 0,#
                  shock.history = "pulse",#
                  inferences.y = "levels", inferences.x = "levels",#
                  effect.type = "discrete",#
                  s.limit = 5,#
                  return.plot = TRUE, return.formulae = FALSE, return.data = FALSE)#
  )#
#
  expect_true( # x-axis label contains expected text#
    # Function output#
    grepl("Number of Periods Since Initial Shock", result$labels$x)#
  )#
#
})
# effect.type invalid#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "cough", prediction.values = NULL, baseline.y = NULL,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "Invalid `effect.type`. `effect.type` must be one of 'discrete' or 'fitted'"#
  )#
#
  # shock.size not numeric#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "discrete", prediction.values = NULL, baseline.y = NULL,#
      baseline.y.se = 0, shock.size = "cough", d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "`shock.size` must be numeric"#
  )#
#
  # shock.size length > 1#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "discrete", prediction.values = NULL, baseline.y = NULL,#
      baseline.y.se = 0, shock.size = c(1, 2), d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "`shock.size` should be a single value"#
  )#
#
  # effect.type = "discrete" with prediction.values supplied#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "discrete", prediction.values = list(x = 1), baseline.y = NULL,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "Do not supply `prediction.values` when `effect.type` = 'discrete'"#
  )#
#
  # effect.type = "discrete" with baseline.y supplied and non-zero#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "discrete", prediction.values = NULL, baseline.y = 5,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "Do not supply `baseline.y` when `effect.type` = 'discrete'"#
  )#
#
  # effect.type = "discrete" with baseline.y.se supplied and non-zero#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "discrete", prediction.values = NULL, baseline.y = NULL,#
      baseline.y.se = 1, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "Do not supply `baseline.y.se` when `effect.type` = 'discrete'"#
  )
# effect.type = "fitted", prediction.values not a list#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = c(x = 1), baseline.y = NULL,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "If using `prediction.values`, it must be a list"#
  )#
#
  # effect.type = "fitted", prediction.values supplied with non-zero baseline.y.se#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = list(x = 1), baseline.y = NULL,#
      baseline.y.se = 1, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "If using `prediction.values`, do not change `baseline.y.se` from 0"#
  )#
#
  # effect.type = "fitted", baseline.y not numeric#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = NULL, baseline.y = "cough",#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "If providing a `baseline.y`, it must be numeric"#
  )#
#
  # effect.type = "fitted", baseline.y length > 1#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = NULL, baseline.y = c(1, 2),#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "Only provide a single `baseline.y` value"#
  )#
#
  # effect.type = "fitted", baseline.y.se not numeric#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = NULL, baseline.y = 2,#
      baseline.y.se = "cough", shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "If providing a `baseline.y.se`, it must be numeric"#
  )#
#
  # effect.type = "fitted", baseline.y.se length > 1 (requires prediction.values = NULL per code check)#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = NULL, baseline.y = 2,#
      baseline.y.se = c(1, 2), shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "Only provide a single `baseline.y.se` value"#
  )
# effect.type = "fitted", d.y = 1, inferences.y = "levels", no baseline.y#
  expect_error(#
    # Function output#
    suppressWarnings(GDRF.dummy.checks(effect.type = "fitted", prediction.values = list(x = 1), baseline.y = NULL,#
      baseline.y.se = 0, shock.size = 1, d.y = 1, inferences.y = "levels", type = "GDRF")),#
#
    # Expected output#
    "There is no baseline for y if `effect.type` = 'fitted' if `d.y` > 0"#
  )#
#
  # effect.type = "fitted", d.y = 0, both baseline.y and prediction.values supplied#
  expect_warning(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = list(x = 1), baseline.y = 5,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "Both `baseline.y` and `prediction.values` supplied; `baseline.y` takes precedence and `prediction.values` will be ignored"#
  )#
#
  # effect.type = "fitted", d.y = 0, prediction.values only (warns about differenced variables)#
  expect_warning(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = list(x = 1), baseline.y = NULL,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "If any differenced variables are included in the model, ensure they are set to 0 in `prediction.values`"#
  )#
#
  # effect.type = "fitted", d.y = 1, prediction.values supplied (warns, not errors)#
  expect_warning(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = list(x = 1), baseline.y = 0,#
      baseline.y.se = 0, shock.size = 1, d.y = 1, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "`prediction.values` is ignored when `d.y` > 0"#
  )#
#
  # effect.type = "fitted", d.y = 1, inferences.y = "differences", non-zero baseline.y#
  expect_warning(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = NULL, baseline.y = 5,#
      baseline.y.se = 0, shock.size = 1, d.y = 1, inferences.y = "differences", type = "GDRF"),#
#
    # Expected output#
    "Assuming anything other than `baseline.y` = 0 when `inferences.y` = 'differences' suggests the model is unstable"#
  )#
#
  # effect.type = "fitted", d.y = 1, inferences.y = "differences", shock.size = 1 (identical to discrete)#
  expect_warning(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = NULL, baseline.y = 0,#
      baseline.y.se = 0, shock.size = 1, d.y = 1, inferences.y = "differences", type = "GDRF"),#
#
    # Expected output#
    "`effect.type` = 'fitted' with `inferences.y` = 'differences' and `shock.size` = 1 is identical to `effect.type` = 'discrete'"#
  )
# effect.type = "fitted", d.y = 1, inferences.y = "levels", no baseline.y#
  expect_error(#
    # Function output#
    suppressWarnings(GDRF.dummy.checks(effect.type = "fitted", prediction.values = list(x = 1), baseline.y = NULL,#
      baseline.y.se = 0, shock.size = 1, d.y = 1, inferences.y = "levels", type = "GDRF")),#
#
    # Expected output#
    "There is no baseline for y if `effect.type` = 'fitted' if `d.y` > 0"#
  )
# effect.type = "fitted", baseline.y.se length > 1 (requires prediction.values = NULL per code check)#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = NULL, baseline.y = 2,#
      baseline.y.se = c(1, 2), shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "Only provide a single `baseline.y.se` value"#
  )
# effect.type = "fitted", d.y = 0, both baseline.y and prediction.values supplied#
  expect_warning(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = list(x = 1), baseline.y = 5,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "Both `baseline.y` and `prediction.values` supplied; `baseline.y` takes precedence and `prediction.values` will be ignored"#
  )
test_that("GDRF.dummy.checks produces the correct warnings and errors", {#
#
  # effect.type invalid#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "cough", prediction.values = NULL, baseline.y = NULL,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "Invalid `effect.type`. `effect.type` must be one of 'discrete' or 'fitted'"#
  )#
#
  # shock.size not numeric#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "discrete", prediction.values = NULL, baseline.y = NULL,#
      baseline.y.se = 0, shock.size = "cough", d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "`shock.size` must be numeric"#
  )#
#
  # shock.size length > 1#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "discrete", prediction.values = NULL, baseline.y = NULL,#
      baseline.y.se = 0, shock.size = c(1, 2), d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "`shock.size` should be a single value"#
  )#
#
  # effect.type = "discrete" with prediction.values supplied#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "discrete", prediction.values = list(x = 1), baseline.y = NULL,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "Do not supply `prediction.values` when `effect.type` = 'discrete'"#
  )#
#
  # effect.type = "discrete" with baseline.y supplied and non-zero#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "discrete", prediction.values = NULL, baseline.y = 5,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "Do not supply `baseline.y` when `effect.type` = 'discrete'"#
  )#
#
  # effect.type = "discrete" with baseline.y.se supplied and non-zero#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "discrete", prediction.values = NULL, baseline.y = NULL,#
      baseline.y.se = 1, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "Do not supply `baseline.y.se` when `effect.type` = 'discrete'"#
  )#
#
  # effect.type = "fitted", both prediction.values and baseline.y are NULL#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = NULL, baseline.y = NULL,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "You must provide either a `baseline.y` value or `prediction.values`"#
  )#
#
  # effect.type = "fitted", prediction.values not a list#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = c(x = 1), baseline.y = NULL,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "If using `prediction.values`, it must be a list"#
  )#
#
  # effect.type = "fitted", prediction.values supplied with non-zero baseline.y.se#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = list(x = 1), baseline.y = NULL,#
      baseline.y.se = 1, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "If using `prediction.values`, do not change `baseline.y.se` from 0"#
  )#
#
  # effect.type = "fitted", baseline.y not numeric#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = NULL, baseline.y = "cough",#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "If providing a `baseline.y`, it must be numeric"#
  )#
#
  # effect.type = "fitted", baseline.y length > 1#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = NULL, baseline.y = c(1, 2),#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "Only provide a single `baseline.y` value"#
  )#
#
  # effect.type = "fitted", baseline.y.se not numeric#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = NULL, baseline.y = 2,#
      baseline.y.se = "cough", shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "If providing a `baseline.y.se`, it must be numeric"#
  )#
#
  # effect.type = "fitted", baseline.y.se length > 1 (requires prediction.values = NULL per code check)#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = NULL, baseline.y = 2,#
      baseline.y.se = c(1, 2), shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "Only provide a single `baseline.y.se` value"#
  )#
#
  # effect.type = "fitted", d.y = 1, inferences.y = "levels", no baseline.y#
  expect_error(#
    # Function output#
    suppressWarnings(GDRF.dummy.checks(effect.type = "fitted", prediction.values = list(x = 1), baseline.y = NULL,#
      baseline.y.se = 0, shock.size = 1, d.y = 1, inferences.y = "levels", type = "GDRF")),#
#
    # Expected output#
    "There is no baseline for y if `effect.type` = 'fitted' if `d.y` > 0"#
  )#
#
  # effect.type = "fitted", d.y = 0, both baseline.y and prediction.values supplied#
  expect_warning(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = list(x = 1), baseline.y = 5,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "Both `baseline.y` and `prediction.values` supplied; `baseline.y` takes precedence and `prediction.values` will be ignored"#
  )#
#
  # effect.type = "fitted", d.y = 0, prediction.values only (warns about differenced variables)#
  expect_warning(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = list(x = 1), baseline.y = NULL,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "If any differenced variables are included in the model, ensure they are set to 0 in `prediction.values`"#
  )#
#
  # effect.type = "fitted", d.y = 1, prediction.values supplied (warns, not errors)#
  expect_warning(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = list(x = 1), baseline.y = 0,#
      baseline.y.se = 0, shock.size = 1, d.y = 1, inferences.y = "levels", type = "GDRF"),#
#
    # Expected output#
    "`prediction.values` is ignored when `d.y` > 0"#
  )#
#
  # effect.type = "fitted", d.y = 1, inferences.y = "differences", non-zero baseline.y#
  expect_warning(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = NULL, baseline.y = 5,#
      baseline.y.se = 0, shock.size = 1, d.y = 1, inferences.y = "differences", type = "GDRF"),#
#
    # Expected output#
    "Assuming anything other than `baseline.y` = 0 when `inferences.y` = 'differences' suggests the model is unstable"#
  )#
#
  # effect.type = "fitted", d.y = 1, inferences.y = "differences", shock.size = 1 (identical to discrete)#
  expect_warning(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = NULL, baseline.y = 0,#
      baseline.y.se = 0, shock.size = 1, d.y = 1, inferences.y = "differences", type = "GDRF"),#
#
    # Expected output#
    "`effect.type` = 'fitted' with `inferences.y` = 'differences' and `shock.size` = 1 is identical to `effect.type` = 'discrete'"#
  )#
#
  # type = "interact" produces "dynamic conditional effect" in error message, not "GDRF"#
  expect_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "discrete", prediction.values = list(x = 1), baseline.y = NULL,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "interact"),#
#
    # Expected output#
    "dynamic conditional effect"#
  )#
#
  # effect.type = "discrete", baseline.y = 0 does not error (0 is the expected no-op value)#
  expect_no_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "discrete", prediction.values = NULL, baseline.y = 0,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF")#
  )#
#
  # effect.type = "discrete", baseline.y.se = 0 does not error (0 is the expected no-op value)#
  expect_no_error(#
    # Function output#
    GDRF.dummy.checks(effect.type = "discrete", prediction.values = NULL, baseline.y = NULL,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF")#
  )#
#
  # valid fitted call with baseline.y and d.y = 0 does not error or warn#
  expect_no_warning(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = NULL, baseline.y = 5,#
      baseline.y.se = 0, shock.size = 1, d.y = 0, inferences.y = "levels", type = "GDRF")#
  )#
#
  # valid fitted call with baseline.y and d.y = 1, inferences.y = "levels" does not error or warn#
  expect_no_warning(#
    # Function output#
    GDRF.dummy.checks(effect.type = "fitted", prediction.values = NULL, baseline.y = 5,#
      baseline.y.se = 0, shock.size = 1, d.y = 1, inferences.y = "levels", type = "GDRF")#
  )#
#
})
test_that("GDRF.gecm.plot errors and warnings are issued correctly", {  #
  # run a model to use for errors#
  model.gecm <- lm(d_y ~ l_1_y + l_1_x + l_1_d_y + d_x + l_1_d_x, data = toy.ts.interaction.data)#
  expect_error( # no x.vrbl#
    # Function output#
    GDRF.gecm.plot(model = model.gecm,#
                   x.vrbl = NULL,#
                   y.vrbl = c("l_1_y" = 1),#
                   x.vrbl.d.x = 0, y.vrbl.d.y = 0,#
                   x.d.vrbl = c("d_x" = 0, "l_1_d_x" = 1),#
                   y.d.vrbl = c("l_1_d_y" = 1),#
                   x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
                   shock.history = "pulse",#
                   inferences.y = "levels", inferences.x = "levels",#
                   s.limit = 3, return.plot = FALSE, return.data = TRUE),#
    # Expected output#
    "Variables in GDRF terms \\(x and y\\) and lagged differences"#
  ) #
  expect_error( # no y.vrbl#
    # Function output#
    GDRF.gecm.plot(model = model.gecm,#
                   x.vrbl = c("l_1_x" = 1),#
                   y.vrbl = NULL,#
                   x.vrbl.d.x = 0, y.vrbl.d.y = 0,#
                   x.d.vrbl = c("d_x" = 0, "l_1_d_x" = 1),#
                   y.d.vrbl = c("l_1_d_y" = 1),#
                   x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
                   shock.history = "pulse",#
                   inferences.y = "levels", inferences.x = "levels",#
                   s.limit = 3, return.plot = FALSE, return.data = TRUE),#
    # Expected output#
    "Variables in GDRF terms \\(x and y\\) and lagged differences"#
  )#
  expect_error( # no x.d.vrbl#
    # Function output#
    GDRF.gecm.plot(model = model.gecm,#
                   x.vrbl = c("l_1_x" = 1),#
                   y.vrbl = c("l_1_y" = 1),#
                   x.vrbl.d.x = 0, y.vrbl.d.y = 0,#
                   x.d.vrbl = NULL,#
                   y.d.vrbl = c("l_1_d_y" = 1),#
                   x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
                   shock.history = "pulse",#
                   inferences.y = "levels", inferences.x = "levels",#
                   s.limit = 3, return.plot = FALSE, return.data = TRUE),#
    # Expected output#
    "Variables in GDRF terms \\(x and y\\) and lagged differences"#
  ) #
  expect_error( # no x.vrbl.d.x#
    # Function output#
    GDRF.gecm.plot(model = model.gecm,#
                   x.vrbl = c("l_1_x" = 1),#
                   y.vrbl = c("l_1_y" = 1),#
                   x.vrbl.d.x = NULL, y.vrbl.d.y = 0,#
                   x.d.vrbl = c("d_x" = 0, "l_1_d_x" = 1),#
                   y.d.vrbl = c("l_1_d_y" = 1),#
                   x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
                   shock.history = "pulse",#
                   inferences.y = "levels", inferences.x = "levels",#
                   s.limit = 3, return.plot = FALSE, return.data = TRUE),#
    # Expected output#
    "Order of differencing of variables in GDRF terms"  #
  ) #
  expect_error( # no y.vrbl.d.y#
    # Function output#
    GDRF.gecm.plot(model = model.gecm,#
                   x.vrbl = c("l_1_x" = 1),#
                   y.vrbl = c("l_1_y" = 1),#
                   x.vrbl.d.x = 0, y.vrbl.d.y = NULL,#
                   x.d.vrbl = c("d_x" = 0, "l_1_d_x" = 1),#
                   y.d.vrbl = c("l_1_d_y" = 1),#
                   x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
                   shock.history = "pulse",#
                   inferences.y = "levels", inferences.x = "levels",#
                   s.limit = 3, return.plot = FALSE, return.data = TRUE),#
    # Expected output#
    "Order of differencing of variables in GDRF terms"  #
  )#
  expect_error( # no x.d.vrbl.d.x#
    # Function output#
    GDRF.gecm.plot(model = model.gecm,#
                   x.vrbl = c("l_1_x" = 1),#
                   y.vrbl = c("l_1_y" = 1),#
                   x.vrbl.d.x = 0, y.vrbl.d.y = 0,#
                   x.d.vrbl = c("d_x" = 0, "l_1_d_x" = 1),#
                   y.d.vrbl = c("l_1_d_y" = 1),#
                   x.d.vrbl.d.x = NULL, y.d.vrbl.d.y = 1,#
                   shock.history = "pulse",#
                   inferences.y = "levels", inferences.x = "levels",#
                   s.limit = 3, return.plot = FALSE, return.data = TRUE),#
    # Expected output#
    "Order of differencing of variables in lagged differences in GDRF must"    #
  ) #
  expect_error( # y.d.vrbl supplied but y.d.vrbl.d.y missing#
    # Function output#
    GDRF.gecm.plot(model = model.gecm,#
                   x.vrbl = c("l_1_x" = 1),#
                   y.vrbl = c("l_1_y" = 1),#
                   x.vrbl.d.x = 0, y.vrbl.d.y = 0,#
                   x.d.vrbl = c("d_x" = 0, "l_1_d_x" = 1),#
                   y.d.vrbl = c("l_1_d_y" = 1),#
                   x.d.vrbl.d.x = 1, y.d.vrbl.d.y = NULL,#
                   shock.history = "pulse",#
                   inferences.y = "levels", inferences.x = "levels",#
                   s.limit = 3, return.plot = FALSE, return.data = TRUE),#
#
    # Expected output#
    "Order of differencing of variables in lagged differences in GDRF must be specified through `y.d.vrbl.d.y`"#
  )#
  expect_error( # x.vrbl.d.x must be integer#
    # Function output#
    GDRF.gecm.plot(model = model.gecm,#
                   x.vrbl = c("l_1_x" = 1),#
                   y.vrbl = c("l_1_y" = 1),#
                   x.vrbl.d.x = 0.5, y.vrbl.d.y = 0,#
                   x.d.vrbl = c("d_x" = 0, "l_1_d_x" = 1),#
                   y.d.vrbl = c("l_1_d_y" = 1),#
                   x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
                   shock.history = "pulse",#
                   inferences.y = "levels", inferences.x = "levels",#
                   s.limit = 3, return.plot = FALSE, return.data = TRUE),#
#
    # Expected output#
    "Order of differencing of variables in GDRF term \\(`x.vrbl.d.x` and `y.vrbl.d.y`\\)"  #
  )#
  expect_error( # y.vrbl.d.y must be integer#
    # Function output#
    GDRF.gecm.plot(model = model.gecm,#
                   x.vrbl = c("l_1_x" = 1),#
                   y.vrbl = c("l_1_y" = 1),#
                   x.vrbl.d.x = 0, y.vrbl.d.y = 0.7,#
                   x.d.vrbl = c("d_x" = 0, "l_1_d_x" = 1),#
                   y.d.vrbl = c("l_1_d_y" = 1),#
                   x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
                   shock.history = "pulse",#
                   inferences.y = "levels", inferences.x = "levels",#
                   s.limit = 3, return.plot = FALSE, return.data = TRUE),#
#
    # Expected output#
    "Order of differencing of variables in GDRF term \\(`x.vrbl.d.x` and `y.vrbl.d.y`\\)"  #
  )#
  expect_error( # x.d.vrbl.d.x must be integer#
    # Function output#
    GDRF.gecm.plot(model = model.gecm,#
                   x.vrbl = c("l_1_x" = 1),#
                   y.vrbl = c("l_1_y" = 1),#
                   x.vrbl.d.x = 0, y.vrbl.d.y = 0,#
                   x.d.vrbl = c("d_x" = 0, "l_1_d_x" = 1),#
                   y.d.vrbl = c("l_1_d_y" = 1),#
                   x.d.vrbl.d.x = 1.3, y.d.vrbl.d.y = 1,#
                   shock.history = "pulse",#
                   inferences.y = "levels", inferences.x = "levels",#
                   s.limit = 3, return.plot = FALSE, return.data = TRUE),#
    # Expected output#
    "Order of differencing of variables in lagged differences in GDRF term \\(`x.d.vrbl.d.x`"  #
  )#
  expect_error( # y.d.vrbl.d.y must be integer#
    # Function output#
    GDRF.gecm.plot(model = model.gecm,#
                   x.vrbl = c("l_1_x" = 1),#
                   y.vrbl = c("l_1_y" = 1),#
                   x.vrbl.d.x = 0, y.vrbl.d.y = 0,#
                   x.d.vrbl = c("d_x" = 0, "l_1_d_x" = 1),#
                   y.d.vrbl = c("l_1_d_y" = 1),#
                   x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 3.14,#
                   shock.history = "pulse",#
                   inferences.y = "levels", inferences.x = "levels",#
                   s.limit = 3, return.plot = FALSE, return.data = TRUE),#
    # Expected output#
    "Order of differencing of variables in lagged differences in GDRF term \\(`y.d.vrbl.d.y`"  #
  )#
  expect_error( # x vrbl not named vector#
    # Function output#
    GDRF.gecm.plot(model = model.gecm,#
                   x.vrbl = c(1),#
                   y.vrbl = c("l_1_y" = 1),#
                   x.vrbl.d.x = 0, y.vrbl.d.y = 0,#
                   x.d.vrbl = c("d_x" = 0, "l_1_d_x" = 1),#
                   y.d.vrbl = c("l_1_d_y" = 1),#
                   x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
                   shock.history = "pulse",#
                   inferences.y = "levels", inferences.x = "levels",#
                   s.limit = 3, return.plot = FALSE, return.data = TRUE),#
    # Expected output#
    "`x.vrbl` should be a named vector"#
  )#
  expect_error( # x vrbl vector has no values#
    # Function output#
    GDRF.gecm.plot(model = model.gecm,#
                   x.vrbl = c("l_1_x"),#
                   y.vrbl = c("l_1_y" = 1),#
                   x.vrbl.d.x = 0, y.vrbl.d.y = 0,#
                   x.d.vrbl = c("d_x" = 0, "l_1_d_x" = 1),#
                   y.d.vrbl = c("l_1_d_y" = 1),#
                   x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
                   shock.history = "pulse",#
                   inferences.y = "levels", inferences.x = "levels",#
                   s.limit = 3, return.plot = FALSE, return.data = TRUE),#
    # Expected error#
    "`x.vrbl` should be a named vector"#
  )#
  expect_error( # y vrbl not named vector#
    # Function output#
    GDRF.gecm.plot(model = model.gecm,#
                   x.vrbl = c("l_1_x" = 1),#
                   y.vrbl = c(1),#
                   x.vrbl.d.x = 0, y.vrbl.d.y = 0,#
                   x.d.vrbl = c("d_x" = 0, "l_1_d_x" = 1),#
                   y.d.vrbl = c("l_1_d_y" = 1),#
                   x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
                   shock.history = "pulse",#
                   inferences.y = "levels", inferences.x = "levels",#
                   s.limit = 3, return.plot = FALSE, return.data = TRUE),#
    # Expected error#
    "`y.vrbl` should be a named vector"#
  )#
  expect_error( # y vrbl vector has no values#
    # Function output#
    GDRF.gecm.plot(model = model.gecm,#
                   x.vrbl = c("l_1_x" = 1),#
                   y.vrbl = c("l_1_y"),#
                   x.vrbl.d.x = 0, y.vrbl.d.y = 0,#
                   x.d.vrbl = c("d_x" = 0, "l_1_d_x" = 1),#
                   y.d.vrbl = c("l_1_d_y" = 1),#
                   x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
                   shock.history = "pulse",#
                   inferences.y = "levels", inferences.x = "levels",#
                   s.limit = 3, return.plot = FALSE, return.data = TRUE),#
    # Expected error#
