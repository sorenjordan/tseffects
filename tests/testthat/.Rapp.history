    seq(0, 1, length.out = 50)#
  )  #
#
  expect_equal( # no z.vals provided: s.lines#
    # Function output     #
    unique(interact.adl.plot(model = model.alllags, #
                   x.vrbl = c("x" = 0, "l_1_x" = 1), #
                   y.vrbl = c("l_1_y" = 1), #
                   z.vrbl = c("z" = 0, "l_1_z" = 1),#
