  expect_true(isSymmetric(kardl.vcov)) #
  expect_true(!is.null(rownames(kardl.vcov)))#
  expect_true(!is.null(colnames(kardl.vcov)))#
  # do the names match?#
  expect_equal(names(kardl.coef), rownames(kardl.vcov))#
  expect_equal(names(kardl.coef), colnames(kardl.vcov))#
#
})  #
#
######################################################################
# get.model.data#
######################################################################
#
test_that("get.model.data returns correct values (kardl)", {#
#
  # get the coefficients and data#
  kardl.coef <- get.model.coef(model.kardl)    #
  kardl.data <- get.model.data(model.kardl, model.info = check.model.class(model.kardl))#
#
  # Is it a dataframe?#
  expect_true(is.data.frame(kardl.data))#
#
  # are the coefficients in it?#
  kardl.coef.vars <- setdiff(names(kardl.coef), "(Intercept)")#
  expect_true(all(kardl.coef.vars %in% names(kardl.data)))  #
#
  # Expected output: correct number of rows/columns #
  expect_equal( # same number of rows#
    # Function output#
    nrow(kardl.data), #
    # Expected output: kardl requires trimming off the rows for the lags (extra for the lagged differences)#
    nrow(toy.ts.interaction.data) - 3#
  ) #
  # Some columns lol#
  expect_true(ncol(kardl.data) > 0)#
#
})  #
#
######################################################################
# calculation#
######################################################################
#
test_that("adl.plot calculates values correctly for method (kardl)", {#
#
  # the model. this formula is wrong but we will just feed it the wrong thing in adl.plot too#
  lrm.formula <- "(L1.x) / (1 - L1.y)"#
  # raw calculations#
  lrm.est.from.raw <- (coef(model.kardl)["L1.x"])/(1 - coef(model.kardl)["L1.y"])#
  lrm.se.from.raw <- deltaMethod(coef(model.kardl), g = lrm.formula, vcov. = vcov(model.kardl))$SE#
#
  # tseffects calculations#
#
  adl.out <- adl.plot(model = model.kardl, #
    y.vrbl = c("L1.y" = 1), #
    x.vrbl = c("L1.x" = 1), #
    shock.history = "step", #
    return.data = TRUE, return.plot = FALSE, return.formulae = FALSE)#
#
  expect_equal( # for the lrm estimate#
    # Function output#
    adl.out$GDRF[adl.out$Period == "LRM"],#
    # Expected output#
    unname(lrm.est.from.raw),#
    tolerance = 1e-3#
  )#
  expect_equal( # for the lrm se#
    # Function output#
    adl.out$SE[adl.out$Period == "LRM"],#
    # Expected output#
    lrm.se.from.raw,#
    tolerance = 1e-3#
  )#
})
