    # Expected output#
    c(1, 0, 0, 0)#
  ) #
  expect_equal( # test whether formula matches for LRM (step) - undefined#
    # Function output   #
    model_test_step$formulae[["LRM"]],#
    # Expected output#
    NULL#
  )#
})#
