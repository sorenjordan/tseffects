load("/Users/sorenjordan/Dropbox/Garrett-Soren/tseffects/tseffects/data/approval.rda")#
load("/Users/sorenjordan/Dropbox/Garrett-Soren/tseffects/tseffects/data/toy.ts.interaction.data.rda")
model.alllags <- lm(y ~#
		x + l_1_x +#
		z + l_1_z  +#
		x_z + z_l_1_x + x_l_1_z +#
		l_1_x_l_1_z, data = toy.ts.interaction.data)
expect_equal( # s = 0; impulse#
    # Function#
    interact.adl.plot(model = model.alllags, #
                   x.vrbl = c("x" = 0, "l_1_x" = 1), #
                   # y.vrbl = c("l_1_y" = 1), #
                   z.vrbl = c("z" = 0, "l_1_z" = 1),#
                   x.z.vrbl = c("x_z" = 0, "z_l_1_x" = 1, "x_l_1_z" = 0, "l_1_x_l_1_z" = 1),#
                   plot.type = "lines",#
                   effect.type = "impulse",#
                   s.limit = 1,#
                   return.plot = FALSE, return.data = FALSE, return.formulae = TRUE)$formulae$`s = 0`,#
#
    # Expected output#
    "x  +  x_z * z_val  +  z_val * x_l_1_z "#
  )
suppressWarnings({interact.adl.plot(model = model.alllags, #
                   x.vrbl = c("x" = 0, "l_1_x" = 1), #
                   # y.vrbl = c("l_1_y" = 1), #
                   z.vrbl = c("z" = 0, "l_1_z" = 1),#
                   x.z.vrbl = c("x_z" = 0, "z_l_1_x" = 1, "x_l_1_z" = 0, "l_1_x_l_1_z" = 1),#
                   plot.type = "lines",#
                   effect.type = "impulse",#
                   s.limit = 1,#
                   return.plot = FALSE, return.data = FALSE, return.formulae = TRUE)$formulae$`s = 0`})
