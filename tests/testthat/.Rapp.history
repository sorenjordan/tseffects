  )#
  expect_error( # no x.vrbl.d.x#
    # Function output#
    ts.ci.gecm.plot(model = model, #
                    x.vrbl = c("l_x" = 1), #
                    y.vrbl = c("l_y" = 1),#
                    # x.vrbl.d.x = 0, #
