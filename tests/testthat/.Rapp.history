#
  expect_equal( # plot + data: names are plot and estimates#
    # Function output#
    names(result.plotdata),#
#
    # Expected output#
    c("plot", "estimates")#
  )#
#
  # plot + formulae, no data#
  result.plotformulae <- GDRF.gecm.plot(model = model.gecm,#
                                         x.vrbl = c("l_1_x" = 1),#
                                         y.vrbl = c("l_1_y" = 1),#
                                         x.vrbl.d.x = 0, y.vrbl.d.y = 0,#
