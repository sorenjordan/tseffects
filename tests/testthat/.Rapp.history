#
  expect_equal( # plot + formulae: names are plot, formulae, shocks#
    # Function output#
    names(result.plotformulae),#
#
    # Expected output#
    c("plot", "formulae", "shocks")#
  )#
#
  # data + formulae, no plot#
  result.dataformulae <- GDRF.gecm.plot(model = model.gecm,#
