#
  # formulae only#
  result.formulae <- GDRF.gecm.plot(model = model.gecm,#
                                     x.vrbl = c("l_1_x" = 1),#
                                     y.vrbl = c("l_1_y" = 1),#
                                     x.vrbl.d.x = 0, y.vrbl.d.y = 0,#
                                     x.d.vrbl = c("d_x" = 0, "l_1_d_x" = 1),#
