test_that("GDRF.gecm.plot gecm.to.adl conversion produces correct ADL structure", {#
  model.gecm <- lm(d_y ~ l_1_y + l_1_x + l_1_d_y + d_x + l_1_d_x,#
                   data = toy.ts.interaction.data)#
  # verify that GDRF.gecm.plot and GDRF.adl.plot on the converted model agree#
  model.adl <- gecm.to.adl(model = model.gecm,#
                             x.vrbl = c("l_1_x" = 1),#
                             y.vrbl = c("l_1_y" = 1),#
                             x.vrbl.d.x = 0, y.vrbl.d.y = 0,#
                             x.d.vrbl = c("d_x" = 0, "l_1_d_x" = 1),#
                             y.d.vrbl = c("l_1_d_y" = 1),#
                             x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1)#
  result.gecm <- GDRF.gecm.plot(model = model.gecm,#
                                 x.vrbl = c("l_1_x" = 1),#
                                 y.vrbl = c("l_1_y" = 1),#
                                 x.vrbl.d.x = 0, y.vrbl.d.y = 0,#
                                 x.d.vrbl = c("d_x" = 0, "l_1_d_x" = 1),#
                                 y.d.vrbl = c("l_1_d_y" = 1),#
                                 x.d.vrbl.d.x = 1, y.d.vrbl.d.y = 1,#
                                 shock.history = "step",#
                                 inferences.y = "levels", inferences.x = "levels",#
                                 effect.type = "discrete",#
                                 shock.size = 1,#
                                 s.limit = 5,#
                                 return.plot = FALSE, return.formulae = FALSE, return.data = TRUE)#
  result.adl <- GDRF.adl.plot(model = model.adl,#
                               x.vrbl = names(coef(model.adl))[grepl("x", names(coef(model.adl)))],#
                               y.vrbl = names(coef(model.adl))[grepl("l_1_y", names(coef(model.adl)))],#
                               shock.history = "step",#
                               inferences.y = "levels", inferences.x = "levels",#
                               effect.type = "discrete",#
                               shock.size = 1,#
                               s.limit = 5,#
                               return.plot = FALSE, return.formulae = FALSE, return.data = TRUE)#
  expect_equal( # GDRF estimates agree between GECM and converted ADL#
    # Function output#
    result.gecm$GDRF[result.gecm$Period != "LRM"],#
    # Expected output#
    result.adl$GDRF[result.adl$Period != "LRM"],#
    tolerance = 1e-6#
  )#
  expect_equal( # SE estimates agree between GECM and converted ADL#
    # Function output#
    result.gecm$SE[result.gecm$Period != "LRM"],#
    # Expected output#
    result.adl$SE[result.adl$Period != "LRM"],#
    tolerance = 1e-6#
  )#
})
