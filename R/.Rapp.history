test_that("kardl_lm model can be constructed", {#
  skip_if_not_installed("kardl")#
  library(kardl)#
  model.kardl_lm <<- kardl::kardl(y ~ x + z, data = toy.ts.interaction.data, mode = c(1, 2, 2))#
  expect_s3_class(model.kardl_lm, "kardl_lm")#
})#
