x + l.1.x + l.2.x +
z + l.1.z +
x.z + l.1.x.l.1.z,
data = toy.ts.interaction.data)
model.alllags <- lm(formula = y ~ l.1.y + x + l.1.x + l.2.x, data = toy.ts.interaction.data)
p <- ts.interact.plot(model = model.alllags,
x.vrbl = c("x" = 0, "l.1.x" = 1),
y.vrbl = c("l.1.y" = 1),
z.vrbl = c("z" = 0, "l.1.z" = 1),
x.z.vrbl = c("x.z" = 0,"l.1.x.l.1.z" = 1),
return.plot = TRUE,
effect.type = "xz.me.zlines", se.type = "HC3",
return.data = FALSE, s.limit = 20)
ts.interact.plot(model = model.alllags,
x.vrbl = c("x" = 0, "l.1.x" = 1),
y.vrbl = c("l.1.y" = 1),
z.vrbl = c("z" = 0, "l.1.z" = 1),
x.z.vrbl = c("x.z" = 0,"l.1.x.l.1.z" = 1),
return.plot = TRUE,
effect.type = "xz.me.zlines", se.type = "HC3",
return.data = FALSE, s.limit = 20)
model.alllags <- lm(formula = y ~ l.1.y + x + l.1.x + l.2.x + z + l.1.z, data = toy.ts.interaction.data)
model.alllags <- lm(formula = y ~ l.1.y + x + l.1.x + l.2.x +
z + l.1.z, data = toy.ts.interaction.data)
ts.interact.plot(model = model.alllags,
x.vrbl = c("x" = 0, "l.1.x" = 1),
y.vrbl = c("l.1.y" = 1),
z.vrbl = c("z" = 0, "l.1.z" = 1),
x.z.vrbl = c("x.z" = 0,"l.1.x.l.1.z" = 1),
return.plot = TRUE,
effect.type = "xz.me.zlines", se.type = "HC3",
return.data = FALSE, s.limit = 20)
model.alllags <- lm(formula = y ~ l.1.y + x + l.1.x + l.2.x +
z + l.1.z + x.z + l.1.x.l.1.z, data = toy.ts.interaction.data)
model.alllags <- lm(formula = y ~ l.1.y + x + l.1.x + l.2.x +
z + l.1.z + x.z + l.1.x.l.1.z, data = toy.ts.interaction.data)
ts.interact.plot(model = model.alllags,
x.vrbl = c("x" = 0, "l.1.x" = 1),
y.vrbl = c("l.1.y" = 1),
z.vrbl = c("z" = 0, "l.1.z" = 1),
x.z.vrbl = c("x.z" = 0,"l.1.x.l.1.z" = 1),
return.plot = TRUE,
effect.type = "xz.me.zlines", se.type = "HC3",
return.data = FALSE, s.limit = 20)
test_that("Correct Plot", {
p <- ts.interact.plot(model = model.alllags,
x.vrbl = c("x" = 0, "l.1.x" = 1),
y.vrbl = c("l.1.y" = 1),
z.vrbl = c("z" = 0, "l.1.z" = 1),
x.z.vrbl = c("x.z" = 0,"l.1.x.l.1.z" = 1),
return.plot = TRUE,
effect.type = "xz.me.zlines", se.type = "HC3",
return.data = FALSE, s.limit = 20)
expect_s3_class(p, "ggplot") # Check if it's a ggplot object
expect_true("layers" %in% names(p))
expect_true("scales" %in% names(p))
expect_warning(p, "Variable names containing . replaced with _")
expect_no_error(p) # Check for errors during plot generation
#expect_warning(p,"Variable names containing . replaced with _")
expect_doppelganger("My Plot", p) # Test the plot
})
