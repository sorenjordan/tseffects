model_test_lte <- ts.ci.gecm.plot(model = model,
x.vrbl = c("lx" = 1),
y.vrbl = c("ly" = 1),
x.vrbl.d.order = 0, y.vrbl.d.order = 0,
x.d.vrbl = c("dx" = 0, "ldx" = 1),
y.d.vrbl = c("ldy" = 1),
x.d.vrbl.d.order = 1, y.d.vrbl.d.order = 1,
te.type = "lte",
inferences.y = "levels", inferences.x = "levels",
h.limit = 2,
return.plot = TRUE, return.formulae = TRUE,
return.data = TRUE)
model_test_cte <- ts.ci.gecm.plot(model = model,
x.vrbl = c("lx" = 1),
y.vrbl = c("ly" = 1),
x.vrbl.d.order = 0, y.vrbl.d.order = 0,
x.d.vrbl = c("dx" = 0, "ldx" = 1),
y.d.vrbl = c("ldy" = 1),
x.d.vrbl.d.order = 1, y.d.vrbl.d.order = 1,
te.type = "cte",
inferences.y = "levels", inferences.x = "levels",
h.limit = 2,
return.plot = TRUE, return.formulae = TRUE,
return.data = TRUE)
expect_equal( # x={0, 1}, y={1}, h=2, LTE, is correct value
# Function
model_test_lte$formulae[['h = 2']],
# Expected output
"ly * lx  +  ldx * ly  +  ly**2 * dx  +  2 * ly * dx * ldy  +  lx * ldy  +  ldx * ldy  +  dx * ldy**2  +  lx  +  ly * dx"
)
expect_equal( # x={0, 1}, y={1}, h=2, CTE, is correct value
# Function
model_test_cte$formulae[['h = 2']],
# Expected output
"dx  +  2 * lx  +  ldx  +  2 * dx * ly  +  dx * ldy  +  lx * ly  +  ldx * ly  +  dx * ly**2  +  2 * dx * ly * ldy  +  lx * ldy  +  ldx * ldy  +  dx * ldy**2"
)
make_expectation('LTE' %in% names(model_test_lte$estimates) &
'Period' %in% names(model_test_lte$estimates) &
'SE' %in% names(model_test_lte$estimates) &
'Lower' %in% names(model_test_lte$estimates) &
'Upper' %in% names(model_test_lte$estimates))
make_expectation('CTE' %in% names(model_test_cte$estimates) &
'Period' %in% names(model_test_cte$estimates) &
'SE' %in% names(model_test_cte$estimates) &
'Lower' %in% names(model_test_cte$estimates) &
'Upper' %in% names(model_test_cte$estimates))
dim_store <- dim(model_test_lte$estimates)
make_expectation(dim_store == as.vector(as.integer(cbind( # Test dimensions
length(model_test_lte$estimates$Period),
length(model_test_lte$estimates)))))
dim_store <- dim(model_test_cte$estimates)
make_expectation(dim_store == as.vector(as.integer(cbind( # Test dimensions
length(model_test_cte$estimates$Period),
length(model_test_cte$estimates)))))
#### Final Tests
